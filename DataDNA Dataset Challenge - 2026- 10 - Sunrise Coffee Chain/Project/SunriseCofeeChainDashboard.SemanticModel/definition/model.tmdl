model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_product","dim_store","fact_daily_sales","fact_store_monthly_profitability","pDataSource"]

annotation PBI_ProTooling = ["MCP-PBIModeling","TMDLView_Desktop","DevMode"]

ref table dim_date
ref table dim_product
ref table dim_store
ref table fact_daily_sales
ref table fact_store_monthly_profitability
ref table _Measures
ref table 'Analysis Dimension'
ref table 'Analysis Metric'

ref cultureInfo en-US

