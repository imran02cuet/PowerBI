	/// Cell background by review flag.
	measure 'BF - Review Flag' = SWITCH([CF - Review Flag Color], "#D64550", "#FBE9EA", "#E0A800", "#FFF6DD", "#2E8B57", "#E8F5EE", "#FFFFFF")
