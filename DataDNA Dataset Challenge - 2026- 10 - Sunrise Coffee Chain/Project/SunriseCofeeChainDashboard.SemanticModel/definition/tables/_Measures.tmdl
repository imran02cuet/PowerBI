		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: 0327d255-1e4c-4fa5-bbdf-ccda0a3a314c

	/// Loyalty net value card text with the estimate caveat.
	measure 'Card Sub - Loyalty Net Value' = "Estimate: member margin less " & [Txt - Redemption Cost] & " redemption cost | cover " & FORMAT([Redemption Cover (x)], "0.0") & "x"
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: 6cd8e5f3-44af-43f4-8c19-b6b4a6a078d9

	/// Adoption card text vs estate average.
	measure 'Card Sub - Adoption' = "Estate average " & FORMAT(CALCULATE([Avg Loyalty Adoption %], REMOVEFILTERS(dim_store)), "0.0%") & " | store-level attribute"
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: 8581935e-ae6f-424b-b2d0-0e60c6dcb2ef

	/// Weekend uplift card text (sample).
	measure 'Card Sub - Weekend' = FORMAT([Weekend Avg Revenue per Record], "£#,0") & " per weekend record vs " & FORMAT([Weekday Avg Revenue per Record], "£#,0") & " weekday"
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: e0df97b2-156a-4f72-b983-1086410ab3af

	/// Bank holiday uplift card text (sample).
	measure 'Card Sub - Bank Holiday' = FORMAT([Bank Holiday Avg Revenue per Record], "£#,0") & " on bank holidays vs " & FORMAT([Non-Bank-Holiday Avg Revenue per Record], "£#,0") & " normal days | " & FORMAT(CALCULATE([Sample Records], dim_date[is_uk_bank_holiday] = TRUE()), "0") & " records"
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: 68f90dfc-8994-4fe0-85fd-e086a6b725bd

	/// Stores-in-scope card text.
	measure 'Card Sub - Stores in Scope' = "of " & FORMAT([Estate Store Count], "0") & " estate stores | " & FORMAT([Stores Not Active], "0") & " not currently Active"
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: 93541ec5-440b-4507-a6cc-08b73e83270a

	/// Stores-to-review card text.
	measure 'Card Sub - Stores to Review' = "Loss-Making " & FORMAT([Stores - Loss-Making], "0") & " | Structural-Loss " & FORMAT([Stores - Structural-Loss], "0") & " | Break-Even (watch) " & FORMAT([Stores - Break-Even], "0")
