		lineageTag: 4ccb622d-718f-4d86-8ceb-9a4006de3490

	/// P4 seasonal profit title.
	measure 'Title - P4 Seasonal Profit' = "Seasonal Profit Pattern | " & [Label - Period]
		displayFolder: 08 Titles\Visual Titles
		lineageTag: 818b3ba6-8303-4912-99e5-38de5eb0655c

	/// P4 bank holiday title.
	measure 'Title - P4 Bank Holiday' = "Bank Holiday Effect by Location Type (Sample) | " & [Label - Period]
		displayFolder: 08 Titles\Visual Titles
		lineageTag: faa8d0cc-cc3f-4cb9-a2d2-1006ce486e8b

	/// P4 trading calendar title.
	measure 'Title - P4 Trading Calendar' = "Trading Calendar Performance (Sample) | " & [Label - Period]
		displayFolder: 08 Titles\Visual Titles
		lineageTag: 0642db4e-7f94-4af5-9d9b-cb7fafcb394b

	/// P5 monthly profit title.
	measure 'Title - P5 Store Monthly Profit' = "Monthly Net Profit & Margin | " & [Label - Store]
		displayFolder: 08 Titles\Visual Titles
		lineageTag: 4c6bff1d-1e4c-475f-b227-9e958c0b3c27

	/// P5 composition title.
	measure 'Title - P5 P&L Composition' = "Where Each £1 of Revenue Goes | " & [Label - Store]
		displayFolder: 08 Titles\Visual Titles
		lineageTag: aa26a7fd-8bd3-4874-a67a-8084bd2bacbd

	/// P5 monthly detail title.
	measure 'Title - P5 Monthly Detail' = "Monthly P&L Detail | " & [Label - Store]
		displayFolder: 08 Titles\Visual Titles
		lineageTag: 8182e62b-e716-4ecf-b5f5-99ace4283e7e

	/// P1 monthly profit subtitle.
	measure 'Subtitle - P1 Monthly Net Profit' = "Highest-profit month: " & [Peak Month (Net Profit)] & " | Lowest: " & [Lowest Month (Net Profit)] & " | Which months carry the year?"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: d5bc6f34-7c20-4d26-bada-f04972da5b97

	/// P1 margin trend subtitle.
	measure 'Subtitle - P1 Margin Trend' = "Weighted margin by month vs prior year | Estate margin " & FORMAT([Estate Net Profit Margin %], "0.0%")
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: eb24e87f-5f85-4ced-81d3-bfd7b26607d0

	/// P1 regional margin subtitle with sample-size warning.
	measure 'Subtitle - P1 Regional Margin' = "Highest: " & [Top Region (Margin)] & " (" & FORMAT([Top Region Margin %], "0.0%") & ") | Lowest: " & [Bottom Region (Margin)] & " (" & FORMAT([Bottom Region Margin %], "0.0%") & ") | " & FORMAT(MINX(ALLSELECTED(dim_store[region]), [Store Count]), "0") & "-" & FORMAT(MAXX(ALLSELECTED(dim_store[region]), [Store Count]), "0") & " stores per region"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: d254ff10-e1f4-4a2d-99b0-5d1d3736124c

	/// P2 scatter subtitle with both correlations.
	measure 'Subtitle - P2 Rent vs Revenue' = "Store level: rent vs revenue r = " & IF(ISBLANK([Corr - Rent vs Revenue per Store-Month]), "n/a", FORMAT([Corr - Rent vs Revenue per Store-Month], "0.00")) & " | rent vs margin r = " & IF(ISBLANK([Corr - Rent vs Net Profit Margin %]), "n/a", FORMAT([Corr - Rent vs Net Profit Margin %], "0.00"))
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 0a4b98ae-acbb-4c7a-b2f5-061d85db909a

	/// P2 cost structure subtitle.
	measure 'Subtitle - P2 Cost Structure' = "Each cost line as % of revenue | Estate net margin " & FORMAT([Estate Net Profit Margin %], "0.0%")
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 14b45b7b-b872-4604-8e54-2294380986bb

	/// P2 decomposition tree subtitle.
	measure 'Subtitle - P2 Profit Driver Tree' = "Expand Region > Location Type > Store on net profit to find the source of the result"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 45b1f3b5-c53a-49c9-9438-51f514b02616

	/// P2 top and bottom subtitle.
	measure 'Subtitle - P2 Top & Bottom Stores' = "Highest: " & [Top Store (Net Profit)] & " (" & FORMAT([Top Store Net Profit] / 1000, "£#,0") & "K) | Lowest: " & [Bottom Store (Net Profit)] & " (" & FORMAT([Bottom Store Net Profit] / 1000, "£#,0") & "K)"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 9faeeef7-8077-41c9-9c4d-31296a90d138

	/// P2 movers subtitle.
	measure 'Subtitle - P2 Store Movers' = IF(ISBLANK([Prior Year]), "Select one year to compare with the prior year", "Most improved: " & [Most Improved Store] & " (" & FORMAT([Most Improved Store YoY £] / 1000, "+£#,0;-£#,0") & "K) | Most deteriorated: " & [Most Deteriorated Store] & " (" & FORMAT([Most Deteriorated Store YoY £] / 1000, "+£#,0;-£#,0") & "K)")
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 7364306c-f4ba-4d48-b51d-46059348721e

	/// P2 review register subtitle.
	measure 'Subtitle - P2 Review Register' = "Status uses documented margin thresholds on the period margin | " & FORMAT([Stores to Review], "0") & " to review, " & FORMAT([Stores - Break-Even], "0") & " on watch"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: d8351853-9b30-4dd5-bd8a-343498b8b840

	/// P3 scatter subtitle.
	measure 'Subtitle - P3 Adoption vs Member Revenue' =
			VAR r = [Corr - Adoption vs Member Revenue %]
			RETURN IF(ISBLANK(r), "Select 3 or more stores to compute the correlation", "r = " & FORMAT(r, "0.00") & " (" & IF(ABS(r) >= 0.6, "strong", IF(ABS(r) >= 0.3, "moderate", "weak")) & ") across " & FORMAT([Store Count], "0") & " stores | association, not proof of incremental spend")
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 142f463b-793e-4cc0-bde6-81cf59362c33

	/// P3 net value subtitle.
	measure 'Subtitle - P3 Net Value by Region' = "Member revenue x estate gross margin, less redemption cost | estimate, not incremental ROI"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 922881e2-bfa3-428b-b0bf-e8b52c3d9e93

	/// P3 cost trend subtitle.
	measure 'Subtitle - P3 Cost Trend' = "Redemption cost as % of member revenue by month | Estate " & FORMAT([Estate Redemption Cost % of Member Revenue], "0.0%")
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 9b330b99-a294-4357-ac54-b0af75873d53

	/// P3 sample basket subtitle.
	measure 'Subtitle - P3 Basket & Loyalty Share' = "Daily sample (about " & FORMAT([Sample Coverage %], "0%") & " of store-days) | member vs non-member basket size cannot be derived from this data"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 77103907-f2a5-42d7-91af-26e87b5607e6

	/// P3 store scorecard subtitle.
	measure 'Subtitle - P3 Store Scorecard' = "Adoption, member revenue share and redemption cost by store | " & FORMAT([Store Count], "0") & " stores"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: bcb4e777-c8de-4f98-9b95-4badc68c7239

	/// P4 mix over time subtitle.
	measure 'Subtitle - P4 Mix Over Time' = "Espresso " & FORMAT([Espresso Share %], "0.0%") & " | Filter " & FORMAT([Filter Share %], "0.0%") & " | Food " & FORMAT([Food Share %], "0.0%") & " | Retail beans " & FORMAT([Retail Beans Share %], "0.0%")
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: f6963205-ae2f-458e-a939-9b0f065e4f81

	/// P4 mix by location type subtitle.
	measure 'Subtitle - P4 Mix by Location Type' = "Share of daily-sample revenue by stream | " & FORMAT(COUNTROWS(VALUES(dim_store[location_type])), "0") & " location types"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 926a2d05-0116-4e0f-90ad-b108d9105f6a

	/// P4 day of week subtitle.
	measure 'Subtitle - P4 Day of Week' = "Peak: " & [Peak Day (Sample)] & " | Lowest: " & [Lowest Day (Sample)] & " | average revenue per sampled record"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 1626d64f-c792-498f-b926-b72750e86f5d

	/// P4 seasonal subtitle.
	measure 'Subtitle - P4 Seasonal Profit' = "Peak month " & [Peak Month (Net Profit)] & " | Lowest month " & [Lowest Month (Net Profit)] & " | Peak quarter (revenue) " & [Peak Quarter (Revenue)] & " | Lowest " & [Lowest Quarter (Revenue)]
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 7dc7cbe8-1f6a-4f91-9531-489bcde205f6

	/// P4 bank holiday subtitle with sample warning.
	measure 'Subtitle - P4 Bank Holiday' = "Bank-holiday vs normal-day revenue per record | few bank-holiday records, so treat small location types with caution"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: a2b6c574-15c7-452b-ab22-4abf3b8bfe2a

	/// P4 trading calendar subtitle.
	measure 'Subtitle - P4 Trading Calendar' = "Standard days vs bank holidays vs Christmas period (daily sample)"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 1eaef586-2b36-4ada-aed9-0f99615faa7a

	/// P5 monthly profit subtitle.
	measure 'Subtitle - P5 Store Monthly Profit' = "Status: " & [Derived Profitability Status] & " | Margin " & FORMAT([Net Profit Margin %], "0.0%") & " vs estate " & FORMAT([Estate Net Profit Margin %], "0.0%")
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 5094029c-5ba1-4141-810d-23cef1b274d9

	/// P5 composition subtitle: every pound of revenue split into cost lines and profit.
	measure 'Subtitle - P5 P&L Composition' = "COGS " & FORMAT([COGS % of Revenue], "0.0%") & " | Staffing " & FORMAT([Staffing % of Revenue], "0.0%") & " | Rent " & FORMAT([Rent % of Revenue], "0.0%") & " | Loyalty " & FORMAT([Loyalty Cost % of Revenue], "0.0%") & " | Net profit " & FORMAT([Net Profit Margin %], "0.0%")
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 2a5e3156-6b45-4377-9c59-53e47da1461b

	/// P5 monthly detail subtitle.
	measure 'Subtitle - P5 Monthly Detail' = FORMAT([Loss-Making Store-Months], "0") & " of " & FORMAT([Store-Months], "0") & " months in loss"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: c2fa21a3-a857-472c-be44-ae80d67318be

	/// KEY DRIVER (what happened): profit, revenue, margin and where each pound of revenue goes.
	measure 'Insight - P1 Key Driver' = "Net profit " & [Txt - Net Profit] & " on " & [Txt - Revenue] & " revenue (" & FORMAT([Net Profit Margin %], "0.0%") & " margin). Of each £1 of revenue: COGS " & FORMAT([COGS % of Revenue] * 100, "0.0") & "p, staffing " & FORMAT([Staffing % of Revenue] * 100, "0.0") & "p, rent " & FORMAT([Rent % of Revenue] * 100, "0.0") & "p, loyalty " & FORMAT([Loyalty Cost % of Revenue] * 100, "0.0") & "p."
		displayFolder: 10 Insights\P1 Executive
		lineageTag: 870ce80e-f6bf-4f93-b375-3e16bd07e52a

	/// TREND: year-on-year movement in revenue, profit and margin.
	measure 'Insight - P1 Trend' = IF(ISBLANK([Prior Year]), "Select a single year to see the year-on-year trend.", "Revenue " & FORMAT([Revenue YoY %], "+0.0%;-0.0%") & " and net profit " & FORMAT([Net Profit YoY %], "+0.0%;-0.0%") & " vs " & FORMAT([Prior Year], "0") & "; margin " & FORMAT([PY Net Profit Margin %], "0.0%") & " to " & FORMAT([Net Profit Margin %], "0.0%") & " (" & FORMAT([Net Profit Margin YoY (pp)], "+0.0;-0.0") & " pp).")
		displayFolder: 10 Insights\P1 Executive
		lineageTag: 1c34888f-e222-4173-9ca2-686be6bd4748

	/// RISK: loss-making months, stores below threshold and region with the highest loss share.
	measure 'Insight - P1 Risk' = FORMAT([Loss-Making Store-Months], "0") & " store-months (" & FORMAT([Loss-Making Store-Months %], "0.0%") & ") made a loss, costing " & [Txt - Net Loss] & ". " & FORMAT([Stores to Review], "0") & " store(s) sit below -2% margin over the period; " & [Highest Loss Share Region] & " has the highest loss-month share (" & FORMAT([Highest Region Loss Share %], "0.0%") & ")."
		displayFolder: 10 Insights\P1 Executive
		lineageTag: a962eb8d-fcd7-4f1e-894d-0f0c3ae08a4f

	/// OPPORTUNITY: size of the margin gap between best and worst region.
	measure 'Insight - P1 Opportunity' = "Regional margin runs from " & [Bottom Region (Margin)] & " (" & FORMAT([Bottom Region Margin %], "0.0%") & ") to " & [Top Region (Margin)] & " (" & FORMAT([Top Region Margin %], "0.0%") & "), a " & FORMAT(([Top Region Margin %] - [Bottom Region Margin %]) * 100, "0.0") & " pp gap: the prize if weaker regions close part of it."
		displayFolder: 10 Insights\P1 Executive
		lineageTag: 0295726e-e4cc-4ee4-acb8-200407210440

	/// NOW WHAT: recommended attention.
	measure 'Insight - P1 Now What' = IF([Stores to Review] = 0, "No store breaches the -2% period-margin threshold, so review the " & FORMAT([Stores - Break-Even], "0") & " break-even stores and the loss-making months behind them; ", "Review the " & FORMAT([Stores to Review], "0") & " flagged store(s); ") & "compare " & [Bottom Region (Margin)] & " with " & [Top Region (Margin)] & " on rent, staffing and location mix; plan staffing around " & [Lowest Month (Net Profit)] & ", the lowest-profit month."
		displayFolder: 10 Insights\P1 Executive
		lineageTag: bbcf3d23-1053-48ab-b4ae-e4e9bf7ecfa4

	/// KEY DRIVER: spread of store profit.
	measure 'Insight - P2 Key Driver' = "Store net profit runs from " & [Bottom Store (Net Profit)] & " (" & FORMAT([Bottom Store Net Profit] / 1000, "£#,0") & "K) to " & [Top Store (Net Profit)] & " (" & FORMAT([Top Store Net Profit] / 1000, "£#,0") & "K); " & [Top Location Type (Margin)] & " has the best margin and " & [Bottom Location Type (Margin)] & " the weakest."
		displayFolder: 10 Insights\P2 Stores
		lineageTag: ca20a28c-c0be-48ff-a023-bd117837cdcf

	/// RISK: derived status distribution and non-active stores.
	measure 'Insight - P2 Risk' = "Status mix: " & FORMAT([Stores - Highly-Profitable], "0") & " Highly-Profitable, " & FORMAT([Stores - Profitable], "0") & " Profitable, " & FORMAT([Stores - Break-Even], "0") & " Break-Even, " & FORMAT([Stores - Loss-Making], "0") & " Loss-Making, " & FORMAT([Stores - Structural-Loss], "0") & " Structural-Loss. " & FORMAT([Stores Not Active], "0") & " store(s) are not currently Active and booked " & FORMAT([Revenue from Non-Active Stores] / 1000000, "£0.0") & "M of revenue."
		displayFolder: 10 Insights\P2 Stores
		lineageTag: 26d0cc9e-804e-4c5b-baee-77db459bb2d9

	/// KEY DRIVER (rent): strength of rent vs revenue and rent vs margin correlation.
	measure 'Insight - P2 Rent' =
			VAR r1 = [Corr - Rent vs Revenue per Store-Month]
			VAR r2 = [Corr - Rent vs Net Profit Margin %]
			RETURN IF(ISBLANK(r1) || ISBLANK(r2), "Select 3 or more stores to assess rent against revenue and margin.", "Rent vs revenue per store-month: " & IF(ABS(r1) >= 0.6, "strong", IF(ABS(r1) >= 0.3, "moderate", "weak")) & IF(r1 >= 0, " positive", " negative") & " (r = " & FORMAT(r1, "0.00") & "); rent vs net margin: " & IF(ABS(r2) >= 0.6, "strong", IF(ABS(r2) >= 0.3, "moderate", "weak")) & IF(r2 >= 0, " positive", " negative") & " (r = " & FORMAT(r2, "0.00") & "). " & IF(r2 <= -0.3, "Higher-rent stores keep less of each pound they earn.", IF(r2 >= 0.3, "Higher rent has not eroded margin.", "Rent level alone does not explain margin differences.")))
		displayFolder: 10 Insights\P2 Stores
		lineageTag: 6d302504-1991-438b-91df-f7595d6fe20f

	/// TREND: most improved and most deteriorated stores and regions.
	measure 'Insight - P2 Movers' = IF(ISBLANK([Prior Year]), "Select one year to see which stores improved or deteriorated.", "Most improved: " & [Most Improved Store] & " (" & FORMAT([Most Improved Store YoY £] / 1000, "+£#,0;-£#,0") & "K); most deteriorated: " & [Most Deteriorated Store] & " (" & FORMAT([Most Deteriorated Store YoY £] / 1000, "+£#,0;-£#,0") & "K). Region gaining most: " & [Top Region (Net Profit YoY £)] & "; losing most: " & [Bottom Region (Net Profit YoY £)] & ".")
		displayFolder: 10 Insights\P2 Stores
		lineageTag: dd239e9b-d3b9-4dd8-9034-cb494d18cea2

	/// NOW WHAT: where to look first.
	measure 'Insight - P2 Now What' = "Start with " & [Bottom Store (Margin)] & " (lowest margin)" & IF(ISBLANK([Most Deteriorated Store]), "", " and " & [Most Deteriorated Store] & " (largest profit decline)") & "; check whether location type, rent burden or staffing explains the gap before any closure decision."
		displayFolder: 10 Insights\P2 Stores
		lineageTag: f8556fcb-e1ae-4f22-adc2-86ff55193ea8

	/// KEY DRIVER: adoption vs member revenue relationship.
	measure 'Insight - P3 Key Driver' =
			VAR r = [Corr - Adoption vs Member Revenue %]
			RETURN IF(ISBLANK(r), "Select 3 or more stores to assess adoption against member revenue share.", "Adoption and member revenue share are " & IF(ABS(r) >= 0.6, "strongly", IF(ABS(r) >= 0.3, "moderately", "weakly")) & IF(r >= 0, " positively", " negatively") & " related across stores (r = " & FORMAT(r, "0.00") & "): stores that enrol more customers earn more of their revenue from members.")
		displayFolder: 10 Insights\P3 Loyalty
		lineageTag: b255f60e-170d-45a2-a521-33fa7b11f69a

	/// KEY DRIVER (cost): redemption cost against member revenue and estimated cover.
	measure 'Insight - P3 Cost' = "Redemption cost is " & FORMAT([Redemption Cost % of Member Revenue], "0.0%") & " of member revenue (estate " & FORMAT([Estate Redemption Cost % of Member Revenue], "0.0%") & "); estimated member gross profit covers it " & FORMAT([Redemption Cover (x)], "0.0") & "x, an estimated net value of " & [Txt - Loyalty Net Value] & "."
		displayFolder: 10 Insights\P3 Loyalty
		lineageTag: 8c23be54-5cfa-4311-b67b-fa0b504a11f4

	/// RISK: limit of the evidence on incremental value.
	measure 'Insight - P3 Risk' = "Member revenue is not proven incremental: members may be existing customers who would have spent anyway. The data has no non-member baseline or member transaction counts, so true programme ROI cannot be established."
		displayFolder: 10 Insights\P3 Loyalty
		lineageTag: 4976c56a-6e3d-45c5-b542-3971b80284b3

	/// OPPORTUNITY: best and weakest region for member revenue share.
	measure 'Insight - P3 Opportunity' = "Member revenue share is highest in " & [Top Region (Member Revenue %)] & " and lowest in " & [Bottom Region (Member Revenue %)] & ": learn what drives enrolment in the leader before investing more."
		displayFolder: 10 Insights\P3 Loyalty
		lineageTag: 87e20abe-da35-4645-aabc-aedb5f1882d5

	/// NOW WHAT: recommended attention.
	measure 'Insight - P3 Now What' = "Before expanding the scheme, run a controlled test or capture member vs non-member transaction counts; meanwhile track redemption cost at " & FORMAT([Redemption Cost % of Member Revenue], "0.0%") & " of member revenue."
		displayFolder: 10 Insights\P3 Loyalty
		lineageTag: 77b40df4-6676-4578-829e-33b5b3803c94

	/// KEY DRIVER: revenue mix shares and food trend (sample).
	measure 'Insight - P4 Key Driver' = "Espresso " & FORMAT([Espresso Share %], "0.0%") & " of sampled revenue, filter " & FORMAT([Filter Share %], "0.0%") & ", food " & FORMAT([Food Share %], "0.0%") & IF(ISBLANK([Food Share YoY (pp)]), "", " (" & FORMAT([Food Share YoY (pp)], "+0.0;-0.0") & " pp vs " & FORMAT([Prior Year], "0") & ")") & ", retail beans " & FORMAT([Retail Beans Share %], "0.0%") & IF(ISBLANK([Retail Beans Share YoY (pp)]), "", " (" & FORMAT([Retail Beans Share YoY (pp)], "+0.0;-0.0") & " pp)") & "."
		displayFolder: 10 Insights\P4 Mix & Seasonality
		lineageTag: 6ffb43d9-9549-478f-9625-0fa33bacf191

	/// TREND: weekend and bank holiday effect (sample).
	measure 'Insight - P4 Calendar' = "Weekends average " & FORMAT([Weekend Uplift %], "+0.0%;-0.0%") & " vs weekdays; bank holidays " & FORMAT([Bank Holiday Uplift %], "+0.0%;-0.0%") & " vs normal days (sample; " & FORMAT(CALCULATE([Sample Records], dim_date[is_uk_bank_holiday] = TRUE()), "0") & " bank-holiday records)."
		displayFolder: 10 Insights\P4 Mix & Seasonality
		lineageTag: b90ed932-90bd-4ebe-a0e2-be6e5517a1a4

	/// TREND: peak and low quarter, month and trading day.
	measure 'Insight - P4 Seasonal' = "Peak quarter by revenue: " & [Peak Quarter (Revenue)] & "; lowest: " & [Lowest Quarter (Revenue)] & ". Highest-profit month " & [Peak Month (Net Profit)] & ", lowest " & [Lowest Month (Net Profit)] & ". Peak trading day " & [Peak Day (Sample)] & ", quietest " & [Lowest Day (Sample)] & "."
		displayFolder: 10 Insights\P4 Mix & Seasonality
		lineageTag: 02d2f554-19cc-4cca-83ec-5191cca1fea2

	/// NOW WHAT: staffing and stock planning with sample caveat.
	measure 'Insight - P4 Now What' = "Align staffing and stock with " & [Peak Quarter (Revenue)] & " demand and " & [Lowest Day (Sample)] & " lows; confirm with full daily data before changing rotas, because the daily table is a sample (about " & FORMAT([Sample Coverage %], "0%") & " of store-days)."
		displayFolder: 10 Insights\P4 Mix & Seasonality
		lineageTag: 64637b05-aac0-4d91-a26f-ebd43ab0b8aa

	/// Tooltip text for one store: region, profit, margin, rank, status, loss months.
	measure 'Tooltip - Store Summary' = IF(HASONEVALUE(dim_store[store_name]), SELECTEDVALUE(dim_store[store_name]) & " | " & SELECTEDVALUE(dim_store[region]) & " | " & SELECTEDVALUE(dim_store[location_type]) & UNICHAR(10) & "Net profit " & [Txt - Net Profit] & " | Margin " & FORMAT([Net Profit Margin %], "0.0%") & " | Rank #" & FORMAT(RANKX(ALL(dim_store[store_name]), [Total Net Profit], , DESC, DENSE), "0") & " of " & FORMAT([Estate Store Count], "0") & UNICHAR(10) & "Status: " & [Derived Profitability Status] & " | Loss months: " & FORMAT([Loss-Making Store-Months], "0"))
		displayFolder: 12 Tooltips
		lineageTag: b27cdf0b-64cf-481b-9a71-2eb093a30642

	/// Tooltip text for one region.
	measure 'Tooltip - Region Summary' = IF(HASONEVALUE(dim_store[region]), SELECTEDVALUE(dim_store[region]) & ": " & FORMAT([Store Count], "0") & " stores" & UNICHAR(10) & "Net profit " & [Txt - Net Profit] & " | Margin " & FORMAT([Net Profit Margin %], "0.0%") & " (" & FORMAT([Margin vs Estate (pp)], "+0.0;-0.0") & " pp vs estate)" & UNICHAR(10) & "Loss-month share " & FORMAT([Loss-Making Store-Months %], "0.0%") & IF([Store Count] < 5, UNICHAR(10) & "Low sample: fewer than 5 stores", ""))
		displayFolder: 12 Tooltips
		lineageTag: 9040e161-3412-43e8-9a4b-1186e21eb6d9

	/// Tooltip text for one month.
	measure 'Tooltip - Month Summary' = IF(HASONEVALUE(dim_date[month_name]), SELECTEDVALUE(dim_date[month_name]) & " | Revenue " & [Txt - Revenue] & " | Net profit " & [Txt - Net Profit] & " | Margin " & FORMAT([Net Profit Margin %], "0.0%") & IF(ISBLANK([Revenue MoM %]), "", UNICHAR(10) & "Revenue vs previous month " & FORMAT([Revenue MoM %], "+0.0%;-0.0%")))
		displayFolder: 12 Tooltips
		lineageTag: 835972de-43f5-4abc-ae96-5d7293f19c69

	/// Tooltip text for loyalty visuals.
	measure 'Tooltip - Loyalty Summary' = "Adoption " & FORMAT([Avg Loyalty Adoption %], "0.0%") & " | Member revenue " & FORMAT([Loyalty Member Revenue %], "0.0%") & " of total" & UNICHAR(10) & "Redemption cost " & FORMAT([Redemption Cost % of Member Revenue], "0.0%") & " of member revenue | Est. net value " & [Txt - Loyalty Net Value]
		displayFolder: 12 Tooltips
		lineageTag: 96c221dd-ac20-4518-b4be-31c3ea691345

	/// Sample-size note for any dimension chart (fewer than 5 stores = low sample).
	measure 'Tooltip - Sample Size Note' = FORMAT([Store Count], "0") & " stores" & IF([Store Count] < 5, " - low sample, interpret with caution", "")
		displayFolder: 12 Tooltips
		lineageTag: 9635aaaf-1a5c-4040-a74f-df7a2fbc1c02

	measure 'Title - P2 Profit by Dimension' = ```
			
			VAR T = VALUES('Analysis Dimension')
			VAR D = IF(COUNTROWS(T) = 1, MAXX(T, 'Analysis Dimension'[Analysis Dimension]), "Region")
			RETURN "Profitability by " & D & " | " & [Label - Period]
			
			```
		displayFolder: 08 Titles\Visual Titles
		lineageTag: 7ad08b66-23f0-4946-99ff-84697f6c4862

	measure 'Subtitle - P2 Profit by Dimension' =
			
			VAR T = VALUES('Analysis Metric')
			VAR M = IF(COUNTROWS(T) = 1, MAXX(T, 'Analysis Metric'[Analysis Metric]), "Total Net Profit")
			RETURN "Metric: " & M & " | switch metric and dimension with the two slicers | low-sample warning below 5 stores"
		displayFolder: 09 Subtitles\Visual Subtitles
		lineageTag: 7a2c6b43-8173-4751-874f-3139a8802bbc

	column Placeholder
		isHidden
		lineageTag: 7ac2c8f3-8c0d-4154-adc4-2db85a7f3490
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW("Placeholder", BLANK())

