	measure 'BF - Margin vs Estate' = SWITCH([CF - Margin vs Estate Color], "#2E8B57", "#E8F5EE", "#D64550", "#FBE9EA", "#FFFFFF")
		displayFolder: 11 Conditional Formatting\BF - Background
		lineageTag: fdfe1873-a3e3-42a4-a8a5-117d9abc48e6

	/// Cell background by rent burden vs estate.
	measure 'BF - Rent vs Estate' = SWITCH([CF - Rent vs Estate Color], "#2E8B57", "#E8F5EE", "#D64550", "#FBE9EA", "#FFFFFF")
		displayFolder: 11 Conditional Formatting\BF - Background
