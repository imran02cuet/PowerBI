		lineageTag: f2670dea-e3f8-4b80-a730-eacfe90ef5cb

	/// Colour by loss-making share vs estate (red when > 1 pp worse).
	measure 'CF - Loss Share vs Estate Color' =
			VAR x = [Loss-Making Share vs Estate (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 1, "#D64550", IF(x < -1, "#2E8B57", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 703431b9-654e-4a87-a7bb-939b525d2530

	/// Green when net profit rose vs prior year, red when it fell (store mover chart).
	measure 'CF - Movers Color' =
			VAR x = [Net Profit YoY £]
			RETURN IF(ISBLANK(x), "#808080", IF(x >= 0, "#2E8B57", "#D64550"))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 59dc2873-a672-4a2c-82dc-194cb77e6a80

	/// Green/red by sign of weekend uplift (sample).
	measure 'CF - Weekend Uplift Color' =
			VAR x = [Weekend Uplift %]
			RETURN IF(ISBLANK(x), "#808080", IF(x >= 0, "#2E8B57", "#D64550"))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 645fcad7-2ba8-465e-9c26-7def8d5c21ef

	/// Green/red by sign of bank holiday uplift (sample).
	measure 'CF - Bank Holiday Uplift Color' =
			VAR x = [Bank Holiday Uplift %]
			RETURN IF(ISBLANK(x), "#808080", IF(x >= 0, "#2E8B57", "#D64550"))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: c227cff8-545d-41a0-90fe-450377dce732

	/// Seasonality index: green >= 1.05, red <= 0.95, grey otherwise.
	measure 'CF - Seasonality Index Color' =
			VAR x = [Revenue Seasonality Index]
			RETURN IF(ISBLANK(x), "#808080", IF(x >= 1.05, "#2E8B57", IF(x <= 0.95, "#D64550", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: ee172ef6-59c8-4f7a-bc46-b3d4d50006a3

	/// Highlights the peak trading day in coffee brown, others in light tan.
	measure 'CF - Peak Day Color' =
			VAR v = [Avg Revenue per Record (Sample)]
			VAR mx = MAXX(ALLSELECTED(dim_date[day_of_week]), [Avg Revenue per Record (Sample)])
			RETURN IF(ISBLANK(v), "#808080", IF(v = mx, "#6F4E37", "#C8B8A8"))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: bf56bb4d-f37a-451f-8376-5d7b07829f1e

	/// Amber when fewer than 5 stores sit behind the number (low sample), grey otherwise.
	measure 'CF - Low Sample Color' = IF([Store Count] < 5, "#E0A800", "#808080")
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: a818bd51-dd28-43c9-9d85-5b4613ca3f90

	/// Light background tint for revenue card (derived from the CF colour).
	measure 'BF - Revenue KPI' = ```
			
			    SWITCH([CF - Revenue YoY Color], 
			        "#2E8B57", "#E8F5EE", 
			        "#D64550", "#FBE9EA", 
			        "#F2F2F2")
			```
		displayFolder: 11 Conditional Formatting\BF - Background
		lineageTag: 8329450c-0bf6-4ffc-adfe-211fa39f7998

	/// Background tint for net profit card.
	measure 'BF - Net Profit KPI' = SWITCH([CF - Net Profit YoY Color], "#2E8B57", "#E8F5EE", "#D64550", "#FBE9EA", "#F2F2F2")
		displayFolder: 11 Conditional Formatting\BF - Background
		lineageTag: a6b1157c-5941-4016-86d7-5ba5899c984f

