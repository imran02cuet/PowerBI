	/// Cell background by derived status.
	measure 'BF - Derived Status' = SWITCH([CF - Derived Status Color], "#1B7F4D", "#E3F2EA", "#5BA97B", "#EAF5EE", "#E0A800", "#FFF6DD", "#D64550", "#FBE9EA", "#8B1A1A", "#F7E1E1", "#FFFFFF")
