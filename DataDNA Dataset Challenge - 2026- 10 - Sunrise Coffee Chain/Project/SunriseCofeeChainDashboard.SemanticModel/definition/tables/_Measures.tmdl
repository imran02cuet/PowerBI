/// Dedicated measure table (no data). All report measures live here, organised in numbered display folders and sub-folders.
table _Measures
	lineageTag: c2d0112d-def9-48bb-9f4d-27ff2246bf82

	/// Single selected calendar year; BLANK when zero or several years are in filter context. Drives all prior-year logic.
	measure 'Selected Year' = SELECTEDVALUE(dim_date[year])
		formatString: 0
		displayFolder: 00 Helpers\Context
		lineageTag: bad6b3ff-d7f6-422a-bd62-25f32e069094

	/// Selected year minus 1; BLANK unless exactly one year is selected.
	measure 'Prior Year' =
			VAR Y = [Selected Year]
			RETURN IF(ISBLANK(Y), BLANK(), Y - 1)
		formatString: 0
		displayFolder: 00 Helpers\Context
		lineageTag: f6f202a5-9a8d-4e92-b559-db44195cf3fa

	/// Gross revenue (monthly fact, full estate coverage).
	measure 'Total Revenue' = SUM(fact_store_monthly_profitability[total_monthly_revenue_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: 8b253c59-d9b4-48f6-8f6e-a8aea0dd0667

	/// Cost of goods sold.
	measure 'Total COGS' = SUM(fact_store_monthly_profitability[total_monthly_cogs_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: f4d6fe51-6571-4edd-9146-3ec03db7edd7

	/// Rent actually charged in the monthly fact (varies around dim_store baseline).
	measure 'Total Rent' = SUM(fact_store_monthly_profitability[monthly_rent_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: 221ec214-b37a-469f-8b51-502985e171e7

	/// Staffing cost actually charged in the monthly fact.
	measure 'Total Staffing Cost' = SUM(fact_store_monthly_profitability[monthly_staffing_cost_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: d71e1600-aecd-4274-9616-a097c5db2076

	/// Cost of loyalty rewards redeemed.
	measure 'Total Loyalty Redemption Cost' = SUM(fact_store_monthly_profitability[loyalty_redemption_cost_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: 11705e9b-79fa-4c29-9fdc-b270bc9a410c

	/// Revenue - COGS - rent - staffing - loyalty redemption (reconciled on all 1,440 rows).
	measure 'Total Net Profit' = SUM(fact_store_monthly_profitability[net_profit_gbp])
		formatString: £#,0;-£#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: b581144c-45c1-45f6-b3bc-1eb7de9741d5

	/// Revenue less COGS (before rent, staffing, loyalty).
	measure 'Gross Profit' = [Total Revenue] - [Total COGS]
		formatString: £#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: 45e7d1f3-79bb-4c33-ab3d-14a8e4a011d7

	/// Revenue from loyalty app members.
	measure 'Loyalty Member Revenue' = SUM(fact_store_monthly_profitability[loyalty_member_spend_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: a9754087-4297-433f-8204-f93a63236181

	/// Revenue from non-members.
	measure 'Non-Member Revenue' = SUM(fact_store_monthly_profitability[non_member_spend_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: ce86cf8d-8834-4694-8a5a-1a5efe65cdbd

	/// Number of store-month records (60 stores x 24 months = 1,440 at estate level).
	measure Store-Months = COUNTROWS(fact_store_monthly_profitability)
		formatString: #,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: d38a5615-8b8e-405b-82d9-30e00570e0c1

	/// Distinct stores with monthly data in the current filter context.
	measure 'Store Count' = DISTINCTCOUNT(fact_store_monthly_profitability[store_id])
		formatString: #,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: 8e4b706b-e496-4133-b232-19dea89b8e57

	/// All stores in dim_store regardless of filters.
	measure 'Estate Store Count' = COUNTROWS(ALL(dim_store))
		formatString: #,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: 24f6a26c-3dfd-461d-93af-556a636197b0

	/// Store-months with negative net profit (actual sign, not the stored status label).
	measure 'Loss-Making Store-Months' = COUNTROWS(FILTER(fact_store_monthly_profitability, fact_store_monthly_profitability[net_profit_gbp] < 0)) + 0
		formatString: #,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: 5f092513-e6ab-4b02-af16-d437cb0892b2

	/// Sum of net profit across store-months where net profit < 0 (negative number).
	measure 'Net Loss in Loss-Making Months' = CALCULATE(SUM(fact_store_monthly_profitability[net_profit_gbp]), fact_store_monthly_profitability[net_profit_gbp] < 0)
		formatString: £#,0;-£#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: ee219bef-0c58-4c6c-ad28-f360a00ff24c

	/// Simple average of monthly revenue per sq ft (no sq ft column exists, so a weighted version is not possible).
	measure 'Avg Revenue per Sq Ft' = AVERAGE(fact_store_monthly_profitability[revenue_per_sqft_gbp])
		formatString: £#,0.00
		displayFolder: 01 Base\Monthly P&L
		lineageTag: b0fcf978-dc27-42ad-9015-4ae5e8157b12

	/// Average of avg_daily_footfall across store-months.
	measure 'Avg Daily Footfall' = AVERAGE(fact_store_monthly_profitability[avg_daily_footfall])
		formatString: #,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: 99615752-7ba1-4b24-becc-789afb64bc02

	/// Average customer dwell time in minutes.
	measure 'Avg Dwell Time (min)' = AVERAGE(fact_store_monthly_profitability[avg_dwell_time_minutes])
		formatString: 0.0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: 6b7a8a9a-7a32-4c98-8d84-3ffba78f84c8

	/// Average monthly rent per store-month (fact).
	measure 'Avg Monthly Rent per Store' = AVERAGE(fact_store_monthly_profitability[monthly_rent_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Monthly P&L
		lineageTag: cf93da27-57c2-4a4e-b164-f83c5df9b3e0

	/// Revenue in fact_daily_sales. SAMPLE ONLY (about 20% of possible store-days) - never compare with Total Revenue.
	measure 'Sample Revenue' = SUM(fact_daily_sales[total_revenue_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 4742d3d2-da0e-4d07-b750-17f942ebdf28

	/// Transactions in the daily sample.
	measure 'Sample Transactions' = SUM(fact_daily_sales[total_transactions])
		formatString: #,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: b112f0bc-9e25-40c9-9be8-ee67ea5e5a3b

	/// Loyalty transactions in the daily sample.
	measure 'Sample Loyalty Transactions' = SUM(fact_daily_sales[loyalty_transactions])
		formatString: #,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: faa9fc3d-86ec-4dd5-b911-be3a76642767

	/// Footfall in the daily sample.
	measure 'Sample Footfall' = SUM(fact_daily_sales[footfall])
		formatString: #,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 1d6e09ba-b33d-4925-b798-2ebee9fbfad1

	/// Daily gross profit in the sample.
	measure 'Sample Gross Profit' = SUM(fact_daily_sales[daily_gross_profit_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 9a72a07e-a0b6-45f2-996c-f2dcb46ca71b

	/// Loyalty redemption cost in the daily sample.
	measure 'Sample Redemption Cost' = SUM(fact_daily_sales[loyalty_redemption_cost_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 12cb7247-6008-4f9d-8f11-859ace398b3c

	/// Espresso revenue (sample).
	measure 'Sample Espresso Revenue' = SUM(fact_daily_sales[espresso_revenue_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 08b592ba-5dcb-4364-b301-88535d89ae7f

	/// Filter coffee revenue (sample).
	measure 'Sample Filter Revenue' = SUM(fact_daily_sales[filter_revenue_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 5824295d-98f0-46bb-98fb-7b4a2d1a16a0

	/// Food revenue (sample).
	measure 'Sample Food Revenue' = SUM(fact_daily_sales[food_revenue_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 5beeed69-f176-4139-a612-202f25641c71

	/// Retail beans revenue (sample).
	measure 'Sample Retail Beans Revenue' = SUM(fact_daily_sales[retail_beans_revenue_gbp])
		formatString: £#,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 42b2ddc3-a488-4770-be85-15f0056aecd8

	/// Total staff hours (sample).
	measure 'Sample Staff Hours' = SUM(fact_daily_sales[total_staff_hours])
		formatString: #,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 1636fa31-6b5f-41a3-8033-e3c3f531ee03

	/// Rows in fact_daily_sales (a store-day can appear on more than one row).
	measure 'Sample Records' = COUNTROWS(fact_daily_sales)
		formatString: #,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: a0b8ecfd-32dc-41fa-bfb2-cc0f40449be5

	/// Distinct store x date combinations in the sample (8,910 at estate level vs 10,000 rows).
	measure 'Sample Store-Days' = COUNTROWS(SUMMARIZE(fact_daily_sales, fact_daily_sales[store_id], fact_daily_sales[date_id]))
		formatString: #,0
		displayFolder: 01 Base\Daily Sample
		lineageTag: 92ef6584-7ec4-4571-9d91-d44f32fe1d04

	/// Weighted net margin = total net profit / total revenue. Never average the stored net_profit_margin_pct column (it is a fraction and misweights small stores).
	measure 'Net Profit Margin %' = DIVIDE([Total Net Profit], [Total Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: af986aa8-6651-4767-94c8-a926e4065745

	/// Gross profit / revenue (monthly fact).
	measure 'Gross Margin %' = DIVIDE([Gross Profit], [Total Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: 2b1c7eee-00f7-41a0-afb0-49dd307bbdde

	/// COGS as % of revenue.
	measure 'COGS % of Revenue' = DIVIDE([Total COGS], [Total Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: 7cc471fd-25e4-4e09-8fa8-014000ac5b2c

	/// Staffing cost as % of revenue.
	measure 'Staffing % of Revenue' = DIVIDE([Total Staffing Cost], [Total Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: 15c75a2e-01b9-4583-9a67-0e59fa7f52ce

	/// Rent as % of revenue (occupancy cost ratio).
	measure 'Rent % of Revenue' = DIVIDE([Total Rent], [Total Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: 8f94febe-13c9-4596-b885-101d42066ce1

	/// Loyalty redemption cost as % of total revenue.
	measure 'Loyalty Cost % of Revenue' = DIVIDE([Total Loyalty Redemption Cost], [Total Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: 6607b9ce-8c3b-4aaa-93df-3f7e79726e5c

	/// Average revenue per store-month (revenue efficiency independent of store count).
	measure 'Revenue per Store-Month' = DIVIDE([Total Revenue], [Store-Months])
		formatString: £#,0
		displayFolder: 02 KPI\Profitability
		lineageTag: eafff492-d3b4-47fd-806a-fcab26fe8511

	/// Average net profit per store-month.
	measure 'Net Profit per Store-Month' = DIVIDE([Total Net Profit], [Store-Months])
		formatString: £#,0;-£#,0
		displayFolder: 02 KPI\Profitability
		lineageTag: f8aa2eed-d5d0-4053-8975-753324988a46

	/// Share of store-months with negative net profit.
	measure 'Loss-Making Store-Months %' = DIVIDE([Loss-Making Store-Months], [Store-Months])
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: 1f7c18b8-6689-4470-a879-27ef602ca2ae

	/// Benchmark: margin of the whole estate for the selected period (store/region filters removed, date filters kept).
	measure 'Estate Net Profit Margin %' = CALCULATE([Net Profit Margin %], REMOVEFILTERS(dim_store))
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: 1f38106f-54b0-41ad-bca0-b3aaaedbedc6

	/// Benchmark: estate-wide loss-making store-month share.
	measure 'Estate Loss-Making Store-Months %' = CALCULATE([Loss-Making Store-Months %], REMOVEFILTERS(dim_store))
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: b1182b23-8b3e-473b-985c-8d2c0f440ae9

	/// Benchmark: estate-wide rent as % of revenue.
	measure 'Estate Rent % of Revenue' = CALCULATE([Rent % of Revenue], REMOVEFILTERS(dim_store))
		formatString: 0.0%
		displayFolder: 02 KPI\Profitability
		lineageTag: e42127c5-feef-42dd-a489-745495a047e4

	/// Weighted share of revenue from loyalty members.
	measure 'Loyalty Member Revenue %' = DIVIDE([Loyalty Member Revenue], [Total Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Loyalty
		lineageTag: b8169090-5827-4783-bfb6-35f6c19bd3a1

	/// Redemption cost per GBP of member revenue (cost of the programme relative to the revenue it touches).
	measure 'Redemption Cost % of Member Revenue' = DIVIDE([Total Loyalty Redemption Cost], [Loyalty Member Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Loyalty
		lineageTag: 3dfd41e7-1c5f-425a-9102-3563ee2130ed

	/// Average store-level loyalty adoption rate (store attribute; not affected by date filters).
	measure 'Avg Loyalty Adoption %' = AVERAGE(dim_store[loyalty_adoption_rate])
		formatString: 0.0%
		displayFolder: 02 KPI\Loyalty
		lineageTag: 96f96f5b-993e-4c9d-83f4-a796c6b0c45d

	/// Benchmark: estate-wide member revenue share.
	measure 'Estate Loyalty Member Revenue %' = CALCULATE([Loyalty Member Revenue %], REMOVEFILTERS(dim_store))
		formatString: 0.0%
		displayFolder: 02 KPI\Loyalty
		lineageTag: c74022ec-de10-4d0b-ba4c-4136c7f2b0b5

	/// Benchmark: estate-wide redemption cost % of member revenue.
	measure 'Estate Redemption Cost % of Member Revenue' = CALCULATE([Redemption Cost % of Member Revenue], REMOVEFILTERS(dim_store))
		formatString: 0.0%
		displayFolder: 02 KPI\Loyalty
		lineageTag: 7aeaa370-5f77-4219-bcdf-dc7986410b21

	/// Loyalty transactions / total transactions (daily sample).
	measure 'Loyalty Txn Share % (Sample)' = DIVIDE([Sample Loyalty Transactions], [Sample Transactions])
		formatString: 0.0%
		displayFolder: 02 KPI\Loyalty
		lineageTag: 59374c5e-6a44-4eac-a1e3-26c6bbea01f3

	/// Revenue / transactions (daily sample).
	measure 'Avg Transaction Value (Sample)' = DIVIDE([Sample Revenue], [Sample Transactions])
		formatString: £0.00
		displayFolder: 02 KPI\Loyalty
		lineageTag: 0977d3d4-379b-4e98-b722-158a1f0e439a

	/// Redemption cost per loyalty transaction (daily sample).
	measure 'Redemption Cost per Loyalty Txn (Sample)' = DIVIDE([Sample Redemption Cost], [Sample Loyalty Transactions])
		formatString: £0.00
		displayFolder: 02 KPI\Loyalty
		lineageTag: 74694141-47f4-4a2e-a209-4882cee4e389

	/// Espresso share of the four tracked streams (sample).
	measure 'Espresso Share %' = DIVIDE([Sample Espresso Revenue], [Sample Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Revenue Mix (Sample)
		lineageTag: 070331cd-69a6-4c12-8426-94f6e4323ab4

	/// Filter coffee share (sample).
	measure 'Filter Share %' = DIVIDE([Sample Filter Revenue], [Sample Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Revenue Mix (Sample)
		lineageTag: eae67ab0-48f9-46db-914e-c30b4b5f3190

	/// Food share (sample).
	measure 'Food Share %' = DIVIDE([Sample Food Revenue], [Sample Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Revenue Mix (Sample)
		lineageTag: 703f7910-0bbc-4ded-81ee-a2118b762bf9

	/// Retail beans share (sample).
	measure 'Retail Beans Share %' = DIVIDE([Sample Retail Beans Revenue], [Sample Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Revenue Mix (Sample)
		lineageTag: 334f561b-2ed0-4d5b-bdf4-062527af5538

	/// Daily gross profit / revenue (sample).
	measure 'Gross Margin % (Sample)' = DIVIDE([Sample Gross Profit], [Sample Revenue])
		formatString: 0.0%
		displayFolder: 02 KPI\Revenue Mix (Sample)
		lineageTag: aeeffef0-db52-47a3-87df-8753dbbb50a6

	/// Transactions / footfall (sample).
	measure 'Conversion Rate % (Sample)' = DIVIDE([Sample Transactions], [Sample Footfall])
		formatString: 0.0%
		displayFolder: 02 KPI\Revenue Mix (Sample)
		lineageTag: 0021adb4-bf75-4539-ae36-eaa960292590

	/// Revenue per labour hour (sample).
	measure 'Revenue per Staff Hour (Sample)' = DIVIDE([Sample Revenue], [Sample Staff Hours])
		formatString: £0.00
		displayFolder: 02 KPI\Revenue Mix (Sample)
		lineageTag: 6b1bca15-8cef-4b4b-9aaa-eccb6b1a44ba

	/// Average revenue per daily-sample record; the safe measure for comparing weekday, weekend and holiday trading because the sample is not a complete census.
	measure 'Avg Revenue per Record (Sample)' = DIVIDE([Sample Revenue], [Sample Records])
		formatString: £#,0
		displayFolder: 02 KPI\Revenue Mix (Sample)
		lineageTag: bfd433cc-bb1a-4d89-97bb-b08a998ec85d

	/// Distinct sampled store-days as % of possible store-days (stores in scope x days in scope).
	measure 'Sample Coverage %' = DIVIDE([Sample Store-Days], COUNTROWS(dim_store) * COUNTROWS(dim_date))
		formatString: 0.0%
		displayFolder: 02 KPI\Revenue Mix (Sample)
		lineageTag: f212c43d-2adb-4f8a-ba8b-f65a04c1b271

	/// Average revenue per record on weekends (sample).
	measure 'Weekend Avg Revenue per Record' = CALCULATE([Avg Revenue per Record (Sample)], dim_date[is_weekend] = TRUE())
		formatString: £#,0
		displayFolder: 02 KPI\Calendar (Sample)
		lineageTag: 4c19f70a-c91c-428e-bdeb-66061b8a2e9a

	/// Average revenue per record on weekdays (sample).
	measure 'Weekday Avg Revenue per Record' = CALCULATE([Avg Revenue per Record (Sample)], dim_date[is_weekend] = FALSE())
		formatString: £#,0
		displayFolder: 02 KPI\Calendar (Sample)
		lineageTag: 9c31c075-2b63-4f3d-b069-50ddeb6c9cd6

	/// Weekend average vs weekday average (sample).
	measure 'Weekend Uplift %' =
			VAR r = DIVIDE([Weekend Avg Revenue per Record], [Weekday Avg Revenue per Record])
			RETURN IF(ISBLANK(r), BLANK(), r - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02 KPI\Calendar (Sample)
		lineageTag: 08d1c068-aa58-476b-a0d7-63b45b7fc2a4

	/// Average revenue per record on England & Wales bank holidays (sample).
	measure 'Bank Holiday Avg Revenue per Record' = CALCULATE([Avg Revenue per Record (Sample)], dim_date[is_uk_bank_holiday] = TRUE())
		formatString: £#,0
		displayFolder: 02 KPI\Calendar (Sample)
		lineageTag: 3a1e7953-bceb-4187-9346-d8091ab69d0e

	/// Average revenue per record on non-bank-holidays (sample).
	measure 'Non-Bank-Holiday Avg Revenue per Record' = CALCULATE([Avg Revenue per Record (Sample)], dim_date[is_uk_bank_holiday] = FALSE())
		formatString: £#,0
		displayFolder: 02 KPI\Calendar (Sample)
		lineageTag: e8307151-9bf4-4e7f-9085-c1f0ca4353b3

	/// Bank-holiday average vs normal-day average (sample; only ~245 bank-holiday records).
	measure 'Bank Holiday Uplift %' =
			VAR r = DIVIDE([Bank Holiday Avg Revenue per Record], [Non-Bank-Holiday Avg Revenue per Record])
			RETURN IF(ISBLANK(r), BLANK(), r - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02 KPI\Calendar (Sample)
		lineageTag: ee40a7f3-7b42-4a07-962f-8fd6a55a6732

	/// Monthly revenue / average monthly revenue across the months in scope (1.00 = average month).
	measure 'Revenue Seasonality Index' = DIVIDE([Total Revenue], AVERAGEX(ALLSELECTED(dim_date[month_number]), [Total Revenue]))
		formatString: 0.00
		displayFolder: 02 KPI\Calendar (Sample)
		lineageTag: c22a032d-b523-4aca-a4e0-e06527dede93

	/// ESTIMATE: member revenue x estate-average gross margin %. Assumes members buy at the same margin as everyone else (no member-level COGS exists).
	measure 'Member Gross Profit (Est.)' = [Loyalty Member Revenue] * [Gross Margin %]
		formatString: £#,0
		displayFolder: 07 Loyalty Analytics\Net Value
		lineageTag: 443d6bbe-9db3-4429-8b3b-c4b9bec69f88

	/// ESTIMATE: estimated member gross profit minus redemption cost. Upper bound - member revenue is not proven incremental, so this is not programme ROI.
	measure 'Loyalty Net Value (Est.)' = [Member Gross Profit (Est.)] - [Total Loyalty Redemption Cost]
		formatString: £#,0;-£#,0
		displayFolder: 07 Loyalty Analytics\Net Value
		lineageTag: 3dc8a0ba-15a3-480c-83f5-d64f8aa79239

	/// Estimated member gross profit per GBP of redemption cost (below 1.0x = programme costs more than the margin on member revenue).
	measure 'Redemption Cover (x)' = DIVIDE([Member Gross Profit (Est.)], [Total Loyalty Redemption Cost])
		formatString: 0.0"x"
		displayFolder: 07 Loyalty Analytics\Net Value
		lineageTag: 90d4e34d-65da-4f9a-a58a-989c8313e84f

	/// Store-level Pearson correlation between loyalty adoption rate and loyalty member revenue %. Association only, not causation. Needs 3+ stores.
	measure 'Corr - Adoption vs Member Revenue %' =
			VAR T =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(dim_store[store_id]),
			            "@x", CALCULATE(MAX(dim_store[loyalty_adoption_rate])),
			            "@y", [Loyalty Member Revenue %]
			        ),
			        NOT ISBLANK([@y])
			    )
			VAR N = COUNTROWS(T)
			VAR MX = AVERAGEX(T, [@x])
			VAR MY = AVERAGEX(T, [@y])
			VAR SXY = SUMX(T, ([@x] - MX) * ([@y] - MY))
			VAR SXX = SUMX(T, ([@x] - MX) ^ 2)
			VAR SYY = SUMX(T, ([@y] - MY) ^ 2)
			RETURN IF(N > 2, DIVIDE(SXY, SQRT(SXX * SYY)))
		formatString: 0.00
		displayFolder: 07 Loyalty Analytics\Correlation
		lineageTag: f1237cf1-6cb4-425f-9211-21d50f96da82

	/// Store-level Pearson correlation between average monthly rent and revenue per store-month.
	measure 'Corr - Rent vs Revenue per Store-Month' =
			VAR T =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(dim_store[store_id]),
			            "@x", [Avg Monthly Rent per Store],
			            "@y", [Revenue per Store-Month]
			        ),
			        NOT ISBLANK([@x]) && NOT ISBLANK([@y])
			    )
			VAR N = COUNTROWS(T)
			VAR MX = AVERAGEX(T, [@x])
			VAR MY = AVERAGEX(T, [@y])
			VAR SXY = SUMX(T, ([@x] - MX) * ([@y] - MY))
			VAR SXX = SUMX(T, ([@x] - MX) ^ 2)
			VAR SYY = SUMX(T, ([@y] - MY) ^ 2)
			RETURN IF(N > 2, DIVIDE(SXY, SQRT(SXX * SYY)))
		formatString: 0.00
		displayFolder: 07 Loyalty Analytics\Correlation
		lineageTag: 4337d85a-aaef-4f12-b981-3679235940ca

	/// Store-level Pearson correlation between average monthly rent and net profit margin.
	measure 'Corr - Rent vs Net Profit Margin %' =
			VAR T =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(dim_store[store_id]),
			            "@x", [Avg Monthly Rent per Store],
			            "@y", [Net Profit Margin %]
			        ),
			        NOT ISBLANK([@x]) && NOT ISBLANK([@y])
			    )
			VAR N = COUNTROWS(T)
			VAR MX = AVERAGEX(T, [@x])
			VAR MY = AVERAGEX(T, [@y])
			VAR SXY = SUMX(T, ([@x] - MX) * ([@y] - MY))
			VAR SXX = SUMX(T, ([@x] - MX) ^ 2)
			VAR SYY = SUMX(T, ([@y] - MY) ^ 2)
			RETURN IF(N > 2, DIVIDE(SXY, SQRT(SXX * SYY)))
		formatString: 0.00
		displayFolder: 07 Loyalty Analytics\Correlation
		lineageTag: 6701af1f-36e2-4478-85d3-c1c6ad291c10

	/// Prior-year revenue (same filters, year replaced by selected year - 1). BLANK unless one year is selected.
	measure 'PY Revenue' = ```
			
			VAR PYr = [Prior Year]
			RETURN 
			    IF(ISBLANK(PYr), BLANK(), CALCULATE([Total Revenue], dim_date[year] = PYr))
			```
		formatString: £#,0
		displayFolder: 03 Time Intelligence\Prior Year
		lineageTag: 37669d77-f36e-40bf-9728-3aefcc50f380

	/// Prior-year net profit.
	measure 'PY Net Profit' =
			VAR PYr = [Prior Year]
			RETURN IF(ISBLANK(PYr), BLANK(), CALCULATE([Total Net Profit], dim_date[year] = PYr))
		formatString: £#,0;-£#,0
		displayFolder: 03 Time Intelligence\Prior Year
		lineageTag: 7c3bb193-de95-4c6a-8449-18300c7110f7

	/// Prior-year weighted net margin.
	measure 'PY Net Profit Margin %' =
			VAR PYr = [Prior Year]
			RETURN IF(ISBLANK(PYr), BLANK(), CALCULATE([Net Profit Margin %], dim_date[year] = PYr))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence\Prior Year
		lineageTag: a8418bf5-5324-4d45-9703-e15442c529e2

	/// Prior-year loss-making store-month share.
	measure 'PY Loss-Making Store-Months %' =
			VAR PYr = [Prior Year]
			RETURN IF(ISBLANK(PYr), BLANK(), CALCULATE([Loss-Making Store-Months %], dim_date[year] = PYr))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence\Prior Year
		lineageTag: 233fd3b2-ad86-4a7d-aaa4-2ff589fbb326

	/// Prior-year loyalty member revenue share.
	measure 'PY Loyalty Member Revenue %' =
			VAR PYr = [Prior Year]
			RETURN IF(ISBLANK(PYr), BLANK(), CALCULATE([Loyalty Member Revenue %], dim_date[year] = PYr))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence\Prior Year
		lineageTag: a6138b64-4d2a-47bc-bdf0-8c28eb647879

	/// Prior-year redemption cost.
	measure 'PY Total Loyalty Redemption Cost' =
			VAR PYr = [Prior Year]
			RETURN IF(ISBLANK(PYr), BLANK(), CALCULATE([Total Loyalty Redemption Cost], dim_date[year] = PYr))
		formatString: £#,0
		displayFolder: 03 Time Intelligence\Prior Year
		lineageTag: 5ff11fef-76af-4d08-8594-583db78fb7b2

	/// Prior-year redemption cost % of member revenue.
	measure 'PY Redemption Cost % of Member Revenue' =
			VAR PYr = [Prior Year]
			RETURN IF(ISBLANK(PYr), BLANK(), CALCULATE([Redemption Cost % of Member Revenue], dim_date[year] = PYr))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence\Prior Year
		lineageTag: 97318c39-607b-4329-bee2-3d68c90879fd

	/// Prior-year food share of revenue (sample).
	measure 'PY Food Share %' =
			VAR PYr = [Prior Year]
			RETURN IF(ISBLANK(PYr), BLANK(), CALCULATE([Food Share %], dim_date[year] = PYr))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence\Prior Year
		lineageTag: b76f30c1-a264-491d-b3ad-42539130c71d

	/// Prior-year retail beans share of revenue (sample).
	measure 'PY Retail Beans Share %' =
			VAR PYr = [Prior Year]
			RETURN IF(ISBLANK(PYr), BLANK(), CALCULATE([Retail Beans Share %], dim_date[year] = PYr))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence\Prior Year
		lineageTag: 97eace2f-e87e-4e3c-9d41-5e7135d18605

	/// Revenue growth vs prior year.
	measure 'Revenue YoY %' = DIVIDE([Total Revenue] - [PY Revenue], [PY Revenue])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: 527a4f9f-7ef1-4086-bc6b-fb016f1fb8ff

	/// Revenue change vs prior year in GBP.
	measure 'Revenue YoY £' = IF(ISBLANK([PY Revenue]), BLANK(), [Total Revenue] - [PY Revenue])
		formatString: +£#,0;-£#,0;£0
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: 2a48cbf6-a0c4-4e54-9cdc-01cd502923d9

	/// Net profit growth vs prior year. Denominator uses ABS(prior) so a store moving from loss to profit shows a positive %.
	measure 'Net Profit YoY %' = DIVIDE([Total Net Profit] - [PY Net Profit], ABS([PY Net Profit]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: 6031804c-ce9f-4c37-a48f-616ff0188b3b

	/// Net profit change vs prior year in GBP (used to find most improved / most deteriorated stores).
	measure 'Net Profit YoY £' = IF(ISBLANK([PY Net Profit]), BLANK(), [Total Net Profit] - [PY Net Profit])
		formatString: +£#,0;-£#,0;£0
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: 23689aff-47d5-4687-b3ce-c39b599196e8

	/// Change in net margin vs prior year, in percentage points.
	measure 'Net Profit Margin YoY (pp)' = IF(ISBLANK([PY Net Profit Margin %]), BLANK(), ([Net Profit Margin %] - [PY Net Profit Margin %]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: 7675beef-a560-46f3-be69-2f3ce8b1d79f

	/// Change in loss-making store-month share vs prior year (pp).
	measure 'Loss-Making Share YoY (pp)' = IF(ISBLANK([PY Loss-Making Store-Months %]), BLANK(), ([Loss-Making Store-Months %] - [PY Loss-Making Store-Months %]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: cf5f4e8c-308a-45f0-82c5-5d9b19e546e3

	/// Change in loyalty member revenue share vs prior year (pp).
	measure 'Member Revenue % YoY (pp)' = IF(ISBLANK([PY Loyalty Member Revenue %]), BLANK(), ([Loyalty Member Revenue %] - [PY Loyalty Member Revenue %]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: dd9e8c90-fbec-4994-b565-62000d679c33

	/// Redemption cost growth vs prior year.
	measure 'Redemption Cost YoY %' = DIVIDE([Total Loyalty Redemption Cost] - [PY Total Loyalty Redemption Cost], [PY Total Loyalty Redemption Cost])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: 9053e31e-2ee1-4e2a-ab89-0c25510302a9

	/// Change in redemption cost % of member revenue vs prior year (pp).
	measure 'Redemption Cost % YoY (pp)' = IF(ISBLANK([PY Redemption Cost % of Member Revenue]), BLANK(), ([Redemption Cost % of Member Revenue] - [PY Redemption Cost % of Member Revenue]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: ee300cb7-4d03-4b73-8f9e-06beb1eef68d

	/// Change in food share vs prior year (pp, sample).
	measure 'Food Share YoY (pp)' = IF(ISBLANK([PY Food Share %]), BLANK(), ([Food Share %] - [PY Food Share %]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: 84d231b9-4942-4e31-a8e3-a187cf971b66

	/// Change in retail beans share vs prior year (pp, sample).
	measure 'Retail Beans Share YoY (pp)' = IF(ISBLANK([PY Retail Beans Share %]), BLANK(), ([Retail Beans Share %] - [PY Retail Beans Share %]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 03 Time Intelligence\Growth & Variance
		lineageTag: 87c053be-1b5f-4e2b-9e61-75a7af7c32c9

	/// Revenue of the previous calendar month. Needs one year and one month in context (e.g. month on a chart axis).
	measure 'Prior Month Revenue' =
			VAR Y = SELECTEDVALUE(dim_date[year])
			VAR M = SELECTEDVALUE(dim_date[month_number])
			VAR Idx = IF(ISBLANK(Y) || ISBLANK(M), BLANK(), Y * 12 + M)
			RETURN
			IF(ISBLANK(Idx), BLANK(),
			    CALCULATE([Total Revenue], REMOVEFILTERS(dim_date),
			        FILTER(ALL(dim_date[year], dim_date[month_number]), dim_date[year] * 12 + dim_date[month_number] = Idx - 1)))
		formatString: £#,0
		displayFolder: 03 Time Intelligence\Month over Month
		lineageTag: fff93cf0-ed73-4487-b000-a34281fceea1

	/// Month-over-month revenue growth.
	measure 'Revenue MoM %' = DIVIDE([Total Revenue] - [Prior Month Revenue], [Prior Month Revenue])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Time Intelligence\Month over Month
		lineageTag: b8ebfa49-9137-4343-9c92-622952bfd832

	/// Net profit of the previous calendar month.
	measure 'Prior Month Net Profit' =
			VAR Y = SELECTEDVALUE(dim_date[year])
			VAR M = SELECTEDVALUE(dim_date[month_number])
			VAR Idx = IF(ISBLANK(Y) || ISBLANK(M), BLANK(), Y * 12 + M)
			RETURN
			IF(ISBLANK(Idx), BLANK(),
			    CALCULATE([Total Net Profit], REMOVEFILTERS(dim_date),
			        FILTER(ALL(dim_date[year], dim_date[month_number]), dim_date[year] * 12 + dim_date[month_number] = Idx - 1)))
		formatString: £#,0;-£#,0
		displayFolder: 03 Time Intelligence\Month over Month
		lineageTag: 6041689a-2da0-4ebe-91fd-bf0aee54d993

	/// Month-over-month net profit growth (ABS denominator).
	measure 'Net Profit MoM %' = DIVIDE([Total Net Profit] - [Prior Month Net Profit], ABS([Prior Month Net Profit]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Time Intelligence\Month over Month
		lineageTag: ee84fb8e-3c67-4764-b1ac-78ef0012288b

	/// Selection margin minus whole-estate margin, in percentage points.
	measure 'Margin vs Estate (pp)' = IF(ISBLANK([Net Profit Margin %]), BLANK(), ([Net Profit Margin %] - [Estate Net Profit Margin %]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 05 Comparison\vs Estate
		lineageTag: 86ea914f-460e-48fc-950b-e9a7f5cc90de

	/// Rent % of revenue minus estate rent % (pp). Positive = heavier rent burden than estate.
	measure 'Rent % vs Estate (pp)' = IF(ISBLANK([Rent % of Revenue]), BLANK(), ([Rent % of Revenue] - [Estate Rent % of Revenue]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 05 Comparison\vs Estate
		lineageTag: 97a78d60-c205-452e-839e-76adc7faa835

	/// Member revenue share minus estate share (pp).
	measure 'Member Revenue % vs Estate (pp)' = IF(ISBLANK([Loyalty Member Revenue %]), BLANK(), ([Loyalty Member Revenue %] - [Estate Loyalty Member Revenue %]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 05 Comparison\vs Estate
		lineageTag: 84f27fb8-c49e-47e8-9923-9aed423ce4e1

	/// Redemption cost % of member revenue minus estate (pp). Positive = costlier programme than estate.
	measure 'Redemption Cost % vs Estate (pp)' = IF(ISBLANK([Redemption Cost % of Member Revenue]), BLANK(), ([Redemption Cost % of Member Revenue] - [Estate Redemption Cost % of Member Revenue]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 05 Comparison\vs Estate
		lineageTag: 1eba0932-b9a0-46c8-8c51-a03a718e5e07

	/// Loss-making store-month share minus estate share (pp).
	measure 'Loss-Making Share vs Estate (pp)' = IF(ISBLANK([Loss-Making Store-Months %]), BLANK(), ([Loss-Making Store-Months %] - [Estate Loss-Making Store-Months %]) * 100)
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: 05 Comparison\vs Estate
		lineageTag: 641d29a3-8504-4c30-a433-232e67fc67a4

	/// Share of estate revenue contributed by the selection (store/region filters removed in the denominator).
	measure 'Revenue Contribution %' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], REMOVEFILTERS(dim_store)))
		formatString: 0.0%
		displayFolder: 05 Comparison\vs Estate
		lineageTag: ac1039cf-ae72-49f9-827b-2bb90a967f41

	/// Share of estate net profit contributed by the selection (negative for loss-making stores).
	measure 'Net Profit Contribution %' = DIVIDE([Total Net Profit], CALCULATE([Total Net Profit], REMOVEFILTERS(dim_store)))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Comparison\vs Estate
		lineageTag: 27995e1a-2cc9-423d-b912-e28ddff4e417

	/// Status derived from weighted margin using the DOCUMENTED thresholds (stored profitability_status bands overlap and are not used): >20% Highly-Profitable, 8-20% Profitable, -2-8% Break-Even, -15 to -2% Loss-Making, <-15% Structural-Loss.
	measure 'Derived Profitability Status' =
			VAR M = [Net Profit Margin %]
			RETURN
			IF(ISBLANK(M), BLANK(),
			    SWITCH(TRUE(),
			        M > 0.20, "Highly-Profitable",
			        M >= 0.08, "Profitable",
			        M >= -0.02, "Break-Even",
			        M >= -0.15, "Loss-Making",
			        "Structural-Loss"))
		displayFolder: 06 Store Status & Risk\Status
		lineageTag: d405b0cf-50b6-41b9-9f88-aaa33df0def4

	/// Sort order for the derived status (1 = best, 5 = worst).
	measure 'Derived Status Order' = SWITCH([Derived Profitability Status], "Highly-Profitable", 1, "Profitable", 2, "Break-Even", 3, "Loss-Making", 4, "Structural-Loss", 5, BLANK())
		formatString: 0
		displayFolder: 06 Store Status & Risk\Status
		lineageTag: 571a33c6-1c47-4810-9e46-487c19e2590f

	/// Review = Loss-Making or Structural-Loss; Watch = Break-Even; OK otherwise.
	measure 'Review Flag' = SWITCH([Derived Profitability Status], "Loss-Making", "Review", "Structural-Loss", "Review", "Break-Even", "Watch", BLANK(), BLANK(), "OK")
		displayFolder: 06 Store Status & Risk\Status
		lineageTag: 6113bfa8-0403-4b09-b5b2-224d471e4471

	/// Stores whose margin for the selected period is above 20%.
	measure 'Stores - Highly-Profitable' = COUNTROWS(FILTER(VALUES(dim_store[store_id]), VAR m = [Net Profit Margin %] RETURN NOT ISBLANK(m) && m > 0.20)) + 0
		formatString: #,0
		displayFolder: 06 Store Status & Risk\Counts
		lineageTag: 44200b8d-9a7b-4a95-bbc8-b953cf21a283

	/// Stores with margin 8% to 20%.
	measure 'Stores - Profitable' = COUNTROWS(FILTER(VALUES(dim_store[store_id]), VAR m = [Net Profit Margin %] RETURN NOT ISBLANK(m) && m >= 0.08 && m <= 0.20)) + 0
		formatString: #,0
		displayFolder: 06 Store Status & Risk\Counts
		lineageTag: 23152532-ec03-4d98-8352-84a062cebb65

	/// Stores with margin -2% to 8%.
	measure 'Stores - Break-Even' = COUNTROWS(FILTER(VALUES(dim_store[store_id]), VAR m = [Net Profit Margin %] RETURN NOT ISBLANK(m) && m >= -0.02 && m < 0.08)) + 0
		formatString: #,0
		displayFolder: 06 Store Status & Risk\Counts
		lineageTag: 273c073e-450a-4182-aa63-fc167e8374d5

	/// Stores with margin -15% to -2%.
	measure 'Stores - Loss-Making' = COUNTROWS(FILTER(VALUES(dim_store[store_id]), VAR m = [Net Profit Margin %] RETURN NOT ISBLANK(m) && m >= -0.15 && m < -0.02)) + 0
		formatString: #,0
		displayFolder: 06 Store Status & Risk\Counts
		lineageTag: d2c0ed51-9bdc-4e79-b131-fa3e300af5f5

	/// Stores with margin below -15%.
	measure 'Stores - Structural-Loss' = COUNTROWS(FILTER(VALUES(dim_store[store_id]), VAR m = [Net Profit Margin %] RETURN NOT ISBLANK(m) && m < -0.15)) + 0
		formatString: #,0
		displayFolder: 06 Store Status & Risk\Counts
		lineageTag: 586f6063-a9a0-4798-b842-22b524d2c436

	/// Stores to review = Loss-Making + Structural-Loss for the selected period.
	measure 'Stores to Review' = [Stores - Loss-Making] + [Stores - Structural-Loss]
		formatString: #,0
		displayFolder: 06 Store Status & Risk\Counts
		lineageTag: 225bda7a-2dff-4997-a015-16a44d8fc965

	/// Stores not currently Active (Temporarily-Closed or Refurbishing). store_status is a current snapshot with no closure date.
	measure 'Stores Not Active' = CALCULATE(COUNTROWS(dim_store), dim_store[store_status] <> "Active") + 0
		formatString: #,0
		displayFolder: 06 Store Status & Risk\Counts
		lineageTag: cfdb7363-8485-41dc-ae6c-404d46b56a55

	/// Revenue booked by stores that are not currently Active.
	measure 'Revenue from Non-Active Stores' = CALCULATE([Total Revenue], dim_store[store_status] <> "Active")
		formatString: £#,0
		displayFolder: 06 Store Status & Risk\Counts
		lineageTag: ddce92cd-f45e-4890-8392-c47ca0d7c8a6

	/// Store-months carrying a stored Loss-Making or Structural-Loss label (compare with Loss-Making Store-Months, which uses the actual sign).
	measure 'Store-Months Flagged Loss (Stored Status)' = CALCULATE(COUNTROWS(fact_store_monthly_profitability), fact_store_monthly_profitability[profitability_status] IN {"Loss-Making", "Structural-Loss"}) + 0
		formatString: #,0
		displayFolder: 06 Store Status & Risk\Counts
		lineageTag: 24bd43c2-3a63-4fcd-9535-779cf42c8c5f

	/// Readable period for titles: single year, or 'first to last year'; adds quarter or month when one is selected.
	measure 'Label - Period' =
			VAR Base = IF(HASONEVALUE(dim_date[year]), FORMAT(SELECTEDVALUE(dim_date[year]), "0"), FORMAT(MIN(dim_date[year]), "0") & " to " & FORMAT(MAX(dim_date[year]), "0"))
			VAR MTxt = IF(ISFILTERED(dim_date[month_name]) && HASONEVALUE(dim_date[month_name]), " " & SELECTEDVALUE(dim_date[month_name]), "")
			VAR QTxt = IF(ISFILTERED(dim_date[quarter]) && HASONEVALUE(dim_date[quarter]), " Q" & FORMAT(SELECTEDVALUE(dim_date[quarter]), "0"), "")
			RETURN Base & IF(MTxt <> "", MTxt, QTxt)
		displayFolder: 00 Helpers\Labels
		lineageTag: de64026f-8cdb-457b-ad54-0d132777405b

	/// Selected region, 'n regions' for a multi-select, or 'All regions'.
	measure 'Label - Region' = IF(ISFILTERED(dim_store[region]), IF(HASONEVALUE(dim_store[region]), SELECTEDVALUE(dim_store[region]), FORMAT(COUNTROWS(VALUES(dim_store[region])), "0") & " regions"), "All regions")
		displayFolder: 00 Helpers\Labels
		lineageTag: 11e997dc-82f0-4f4c-9bec-e28404bd99d4

	/// Selected location type or 'All location types'.
	measure 'Label - Location Type' = IF(ISFILTERED(dim_store[location_type]), IF(HASONEVALUE(dim_store[location_type]), SELECTEDVALUE(dim_store[location_type]), FORMAT(COUNTROWS(VALUES(dim_store[location_type])), "0") & " location types"), "All location types")
		displayFolder: 00 Helpers\Labels
		lineageTag: e862b450-c265-4a89-8f39-af57a3363528

	/// Store name when one store is in context, else 'n stores'.
	measure 'Label - Store' = IF(HASONEVALUE(dim_store[store_name]), SELECTEDVALUE(dim_store[store_name]), FORMAT([Store Count], "0") & " stores")
		displayFolder: 00 Helpers\Labels
		lineageTag: cb9b2546-ec6f-4788-b281-150fbacde7cf

	/// Combined region and location-type scope for page subtitles.
	measure 'Label - Scope' = [Label - Region] & " | " & [Label - Location Type]
		displayFolder: 00 Helpers\Labels
		lineageTag: 6bd4be5d-f837-41d0-aa85-b162c82748ca

	/// Revenue as adaptive text (GBP K or M).
	measure 'Txt - Revenue' =
			VAR v = [Total Revenue]
			RETURN IF(ISBLANK(v), "n/a", IF(ABS(v) >= 1000000, FORMAT(v / 1000000, "£#,0.0") & "M", IF(ABS(v) >= 1000, FORMAT(v / 1000, "£#,0") & "K", FORMAT(v, "£#,0"))))
		displayFolder: 00 Helpers\Text Formatting
		lineageTag: 24b9f1c0-2d21-4ed8-969c-3eac344a5cf5

	/// Net profit as adaptive text.
	measure 'Txt - Net Profit' =
			VAR v = [Total Net Profit]
			RETURN IF(ISBLANK(v), "n/a", IF(ABS(v) >= 1000000, FORMAT(v / 1000000, "£#,0.0") & "M", IF(ABS(v) >= 1000, FORMAT(v / 1000, "£#,0") & "K", FORMAT(v, "£#,0"))))
		displayFolder: 00 Helpers\Text Formatting
		lineageTag: 890cfee8-6569-4826-95ad-73ba10f7ad29

	/// Signed net profit change vs prior year as adaptive text.
	measure 'Txt - Net Profit Change' =
			VAR v = [Net Profit YoY £]
			VAR a = ABS(v)
			RETURN IF(ISBLANK(v), BLANK(), IF(v >= 0, "+", "-") & IF(a >= 1000000, FORMAT(a / 1000000, "£#,0.0") & "M", IF(a >= 1000, FORMAT(a / 1000, "£#,0") & "K", FORMAT(a, "£#,0"))))
		displayFolder: 00 Helpers\Text Formatting
		lineageTag: 043179c0-e41b-4bf1-b230-90f090aa126f

	/// Loyalty redemption cost as adaptive text.
	measure 'Txt - Redemption Cost' =
			VAR v = [Total Loyalty Redemption Cost]
			RETURN IF(ISBLANK(v), "n/a", IF(ABS(v) >= 1000000, FORMAT(v / 1000000, "£#,0.0") & "M", IF(ABS(v) >= 1000, FORMAT(v / 1000, "£#,0") & "K", FORMAT(v, "£#,0"))))
		displayFolder: 00 Helpers\Text Formatting
		lineageTag: bd013080-3983-426a-b286-074cfe64937f

	/// Estimated loyalty net value as adaptive text.
	measure 'Txt - Loyalty Net Value' =
			VAR v = [Loyalty Net Value (Est.)]
			RETURN IF(ISBLANK(v), "n/a", IF(ABS(v) >= 1000000, FORMAT(v / 1000000, "£#,0.0") & "M", IF(ABS(v) >= 1000, FORMAT(v / 1000, "£#,0") & "K", FORMAT(v, "£#,0"))))
		displayFolder: 00 Helpers\Text Formatting
		lineageTag: 96cd3b94-db0b-4078-8ad8-692dfcd8b0dc

	/// Absolute net loss in loss-making months as adaptive text (e.g. 662K).
	measure 'Txt - Net Loss' =
			VAR v = ABS([Net Loss in Loss-Making Months])
			RETURN IF(ISBLANK(v), "n/a", IF(v >= 1000000, FORMAT(v / 1000000, "£#,0.0") & "M", IF(v >= 1000, FORMAT(v / 1000, "£#,0") & "K", FORMAT(v, "£#,0"))))
		displayFolder: 00 Helpers\Text Formatting
		lineageTag: b589e5a1-e5f4-4d67-b2f1-7bb181fb9a21

	/// Rank of the store by net profit (1 = highest). Only evaluates when one store is in context.
	measure 'Rank - Store Net Profit' = IF(HASONEVALUE(dim_store[store_name]), RANKX(ALLSELECTED(dim_store[store_name]), [Total Net Profit], , DESC, DENSE))
		formatString: "#"0
		displayFolder: 04 Ranking\Rank
		lineageTag: 9dafcebd-cdf8-4268-90d3-2e422362b290

	/// Rank of the store by weighted net margin (1 = highest).
	measure 'Rank - Store Margin' = IF(HASONEVALUE(dim_store[store_name]), RANKX(ALLSELECTED(dim_store[store_name]), [Net Profit Margin %], , DESC, DENSE))
		formatString: "#"0
		displayFolder: 04 Ranking\Rank
		lineageTag: 22b969b1-ae0e-4eb7-bc60-9a4b9aba903f

	/// Rank of the store by net profit improvement vs prior year (1 = biggest improvement).
	measure 'Rank - Store Net Profit YoY (Improvers)' = IF(HASONEVALUE(dim_store[store_name]) && NOT ISBLANK([Net Profit YoY £]), RANKX(ALLSELECTED(dim_store[store_name]), [Net Profit YoY £], , DESC, DENSE))
		formatString: "#"0
		displayFolder: 04 Ranking\Rank
		lineageTag: 7aac63b1-0dc4-4401-bef8-a8138f5549b8

	/// Rank of the store by net profit decline vs prior year (1 = biggest deterioration).
	measure 'Rank - Store Net Profit YoY (Decliners)' = IF(HASONEVALUE(dim_store[store_name]) && NOT ISBLANK([Net Profit YoY £]), RANKX(ALLSELECTED(dim_store[store_name]), [Net Profit YoY £], , ASC, DENSE))
		formatString: "#"0
		displayFolder: 04 Ranking\Rank
		lineageTag: 4b5a5bf3-8f57-4d92-8208-8f66bc5c6859

	/// Rank of the region by weighted net margin (1 = highest).
	measure 'Rank - Region Margin' = IF(HASONEVALUE(dim_store[region]), RANKX(ALLSELECTED(dim_store[region]), [Net Profit Margin %], , DESC, DENSE))
		formatString: "#"0
		displayFolder: 04 Ranking\Rank
		lineageTag: fa5368c1-9ca4-4918-9a0c-62c339cea283

	/// 1 for the 5 highest and 5 lowest stores by net profit - use as a visual-level filter (is 1) for a Top & Bottom 5 chart.
	measure 'Flag - Top & Bottom 5 Stores (Net Profit)' =
			IF(HASONEVALUE(dim_store[store_name]),
			    VAR N = COUNTROWS(ALLSELECTED(dim_store[store_name]))
			    VAR R = [Rank - Store Net Profit]
			    RETURN IF(R <= 5 || R > N - 5, 1, 0))
		formatString: 0
		displayFolder: 04 Ranking\Chart Filters
		lineageTag: 4f7a880d-ee91-4a8b-b446-7777eeabcec9

	/// 1 for the 5 biggest improvers and 5 biggest decliners vs prior year - visual-level filter (is 1).
	measure 'Flag - Top & Bottom 5 Movers (YoY)' =
			IF(HASONEVALUE(dim_store[store_name]) && NOT ISBLANK([Net Profit YoY £]),
			    IF([Rank - Store Net Profit YoY (Improvers)] <= 5 || [Rank - Store Net Profit YoY (Decliners)] <= 5, 1, 0))
		formatString: 0
		displayFolder: 04 Ranking\Chart Filters
		lineageTag: 528759b6-36ae-4a04-b02d-1e6ee20a7522

	/// Store with the highest net profit in the current selection.
	measure 'Top Store (Net Profit)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[store_name]), [Total Net Profit], DESC), dim_store[store_name], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 031a72ef-0664-4f2b-9536-cd0587fb1c4e

	/// Net profit of the top store.
	measure 'Top Store Net Profit' = MAXX(ALLSELECTED(dim_store[store_name]), [Total Net Profit])
		formatString: £#,0;-£#,0
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 89e5e32e-58f0-49af-8723-6074ca6c02fa

	/// Store with the lowest net profit in the current selection.
	measure 'Bottom Store (Net Profit)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[store_name]), [Total Net Profit], ASC), dim_store[store_name], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 1b06515e-d1ab-45fd-8ff9-ed4a8a18a380

	/// Net profit of the bottom store.
	measure 'Bottom Store Net Profit' = MINX(ALLSELECTED(dim_store[store_name]), [Total Net Profit])
		formatString: £#,0;-£#,0
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: b501b6f6-2c59-498e-a49d-0c960956dfff

	/// Store with the highest weighted margin.
	measure 'Top Store (Margin)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[store_name]), [Net Profit Margin %], DESC), dim_store[store_name], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 5ab9eb43-a4e9-46c9-ab5c-8d4c836cf351

	/// Store with the lowest weighted margin.
	measure 'Bottom Store (Margin)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[store_name]), [Net Profit Margin %], ASC), dim_store[store_name], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 2e380529-9121-4581-a80c-810e2ab38348

	/// Store whose net profit rose most vs prior year. BLANK unless one year is selected.
	measure 'Most Improved Store' = IF(ISBLANK([Prior Year]), BLANK(), CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[store_name]), [Net Profit YoY £], DESC), dim_store[store_name], ", "))
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 4265727f-f16c-4f2d-99ec-4af526839c29

	/// GBP improvement of the most improved store.
	measure 'Most Improved Store YoY £' = IF(ISBLANK([Prior Year]), BLANK(), MAXX(ALLSELECTED(dim_store[store_name]), [Net Profit YoY £]))
		formatString: +£#,0;-£#,0;£0
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 9ac89943-2778-4b19-a651-7926a67fa0c8

	/// Store whose net profit fell most vs prior year.
	measure 'Most Deteriorated Store' = IF(ISBLANK([Prior Year]), BLANK(), CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[store_name]), [Net Profit YoY £], ASC), dim_store[store_name], ", "))
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 9f17d0bc-7725-4472-bfc7-c193e19e3597

	/// GBP decline of the most deteriorated store.
	measure 'Most Deteriorated Store YoY £' = IF(ISBLANK([Prior Year]), BLANK(), MINX(ALLSELECTED(dim_store[store_name]), [Net Profit YoY £]))
		formatString: +£#,0;-£#,0;£0
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 725a1f3e-0596-4d8b-9eec-94149aeae583

	/// Region with the highest weighted net margin.
	measure 'Top Region (Margin)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[region]), [Net Profit Margin %], DESC), dim_store[region], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 5a7c2591-247d-46c3-bee1-bfe247a0ff96

	/// Highest regional margin.
	measure 'Top Region Margin %' = MAXX(ALLSELECTED(dim_store[region]), [Net Profit Margin %])
		formatString: 0.0%
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: c3c941b3-b5ad-4166-b6c9-4d55cb7d8974

	/// Region with the lowest weighted net margin.
	measure 'Bottom Region (Margin)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[region]), [Net Profit Margin %], ASC), dim_store[region], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 04653fb7-a733-49b6-8bf1-5521a40e6804

	/// Lowest regional margin.
	measure 'Bottom Region Margin %' = MINX(ALLSELECTED(dim_store[region]), [Net Profit Margin %])
		formatString: 0.0%
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 20396366-61e6-43e6-a7fa-8706ac6b2cf3

	/// Region with the biggest net profit gain vs prior year.
	measure 'Top Region (Net Profit YoY £)' = IF(ISBLANK([Prior Year]), BLANK(), CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[region]), [Net Profit YoY £], DESC), dim_store[region], ", "))
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: c8222540-72e3-4cd2-a0a1-e39bdec5e2d0

	/// GBP gain of the top-growth region.
	measure 'Top Region Net Profit YoY £' = IF(ISBLANK([Prior Year]), BLANK(), MAXX(ALLSELECTED(dim_store[region]), [Net Profit YoY £]))
		formatString: +£#,0;-£#,0;£0
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 73ea9ad5-b0b2-40a2-ba24-023bb690f0d0

	/// Region with the biggest net profit decline vs prior year.
	measure 'Bottom Region (Net Profit YoY £)' = IF(ISBLANK([Prior Year]), BLANK(), CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[region]), [Net Profit YoY £], ASC), dim_store[region], ", "))
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: cc69f560-2b84-4435-893b-5cccc434ef73

	/// GBP decline of the weakest-growth region.
	measure 'Bottom Region Net Profit YoY £' = IF(ISBLANK([Prior Year]), BLANK(), MINX(ALLSELECTED(dim_store[region]), [Net Profit YoY £]))
		formatString: +£#,0;-£#,0;£0
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 84fdc2fe-62aa-4464-8891-e31e409656ef

	/// Location type with the highest weighted margin.
	measure 'Top Location Type (Margin)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[location_type]), [Net Profit Margin %], DESC), dim_store[location_type], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 9397cce1-6846-416c-bed1-321f941c6b6c

	/// Location type with the lowest weighted margin.
	measure 'Bottom Location Type (Margin)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[location_type]), [Net Profit Margin %], ASC), dim_store[location_type], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 1b8a6d44-8922-4608-bc8f-611c90c4e67a

	/// Region with the highest share of loss-making store-months.
	measure 'Highest Loss Share Region' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[region]), [Loss-Making Store-Months %], DESC), dim_store[region], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: cf4d593b-c64f-467b-86d7-71f1b7a51697

	/// Highest regional loss-making store-month share.
	measure 'Highest Region Loss Share %' = MAXX(ALLSELECTED(dim_store[region]), [Loss-Making Store-Months %])
		formatString: 0.0%
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 6367a5f3-6743-4a75-9474-1eb8516f575d

	/// Region with the highest loyalty member revenue share.
	measure 'Top Region (Member Revenue %)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[region]), [Loyalty Member Revenue %], DESC), dim_store[region], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: b7cf7a48-11f3-4e6b-9c7a-9eca53a2a073

	/// Region with the lowest loyalty member revenue share.
	measure 'Bottom Region (Member Revenue %)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_store[region]), [Loyalty Member Revenue %], ASC), dim_store[region], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 6ee0e1d4-0031-4ad8-899d-b9fc2d96739e

	/// Calendar month with the highest estate net profit in the selection.
	measure 'Peak Month (Net Profit)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_date[month_number], dim_date[month_name]), [Total Net Profit], DESC), dim_date[month_name], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 2f4dc37a-3540-4f17-8df4-e6e442eb443f

	/// Calendar month with the lowest estate net profit in the selection.
	measure 'Lowest Month (Net Profit)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_date[month_number], dim_date[month_name]), [Total Net Profit], ASC), dim_date[month_name], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 0a46c764-a8a7-485a-a357-9a886094e388

	/// Quarter with the highest revenue in the selection.
	measure 'Peak Quarter (Revenue)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_date[quarter]), [Total Revenue], DESC), "Q" & FORMAT(dim_date[quarter], "0"), ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: ba9bc12c-ced8-42e5-981b-d191f7f87d39

	/// Quarter with the lowest revenue in the selection.
	measure 'Lowest Quarter (Revenue)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_date[quarter]), [Total Revenue], ASC), "Q" & FORMAT(dim_date[quarter], "0"), ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 3859dd96-fca5-446a-8ce3-4b590508b5eb

	/// Day of week with the highest average revenue per sample record.
	measure 'Peak Day (Sample)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_date[day_of_week]), [Avg Revenue per Record (Sample)], DESC), dim_date[day_of_week], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 71e278d3-14ea-42d8-af66-8353edae543a

	/// Day of week with the lowest average revenue per sample record.
	measure 'Lowest Day (Sample)' = CONCATENATEX(TOPN(1, ALLSELECTED(dim_date[day_of_week]), [Avg Revenue per Record (Sample)], ASC), dim_date[day_of_week], ", ")
		displayFolder: 04 Ranking\Top & Bottom
		lineageTag: 17f6fa47-83f7-49fc-8118-522b7dd8c7f1

	/// Font/data colour: revenue growth vs prior year. Green > +1%, red < -1%, grey otherwise or no comparison.
	measure 'CF - Revenue YoY Color' = ```
			
			VAR x = [Revenue YoY %]
			RETURN 
			    IF(ISBLANK(x), "#808080", IF(x > 0.01, "#2E8B57", IF(x < -0.01, "#D64550", "#808080")))
			```
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 11261b37-d35c-47cc-97e4-37f042b33075

	/// Font/data colour: net profit growth vs prior year (+/-1% neutral band).
	measure 'CF - Net Profit YoY Color' =
			VAR x = [Net Profit YoY %]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 0.01, "#2E8B57", IF(x < -0.01, "#D64550", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 78d46530-a4e3-4412-bc14-af1dcffc4913

	/// Font/data colour: margin change in pp (+/-0.5 pp neutral band).
	measure 'CF - Margin YoY Color' =
			VAR x = [Net Profit Margin YoY (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 0.5, "#2E8B57", IF(x < -0.5, "#D64550", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: cf9f7fe2-d617-4ecb-9d84-d7dc0f0360c8

	/// Font/data colour: loss-making share vs prior year (LOWER is better).
	measure 'CF - Loss Share YoY Color' =
			VAR x = [Loss-Making Share YoY (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x < -0.5, "#2E8B57", IF(x > 0.5, "#D64550", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: df75aeb4-056b-4c20-8dd3-927efb5d855a

	/// Font/data colour: redemption cost % of member revenue vs prior year (LOWER is better).
	measure 'CF - Redemption Cost YoY Color' =
			VAR x = [Redemption Cost % YoY (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x < -0.5, "#2E8B57", IF(x > 0.5, "#D64550", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: cb23251a-3187-4306-bc4d-739c6f64bcc4

	/// Font/data colour: member revenue share vs prior year (higher is better).
	measure 'CF - Member Revenue YoY Color' =
			VAR x = [Member Revenue % YoY (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 0.5, "#2E8B57", IF(x < -0.5, "#D64550", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 403399cd-b37a-49da-a913-dcc1e39101d3

	/// Font/data colour: food share change vs prior year (pp).
	measure 'CF - Food Share YoY Color' =
			VAR x = [Food Share YoY (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 0.5, "#2E8B57", IF(x < -0.5, "#D64550", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 4ce54cc7-57bc-4e09-bdcc-b510d5bc6ced

	/// Font/data colour: retail beans share change vs prior year (pp).
	measure 'CF - Beans Share YoY Color' =
			VAR x = [Retail Beans Share YoY (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 0.5, "#2E8B57", IF(x < -0.5, "#D64550", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: c01909ff-b355-4688-82fd-f4cacd3078ef

	/// Bar colour: coffee brown for profit, red for loss.
	measure 'CF - Net Profit Sign Color' =
			VAR x = [Total Net Profit]
			RETURN IF(ISBLANK(x), "#808080", IF(x < 0, "#D64550", "#6F4E37"))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: d27ce270-3b41-406c-886b-82ef6ecff4cc

	/// Colour by margin vs estate: green > +1 pp, red < -1 pp, grey between.
	measure 'CF - Margin vs Estate Color' =
			VAR x = [Margin vs Estate (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 1, "#2E8B57", IF(x < -1, "#D64550", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 52b6e70d-6844-4500-8ff1-5ee841d6a3d3

	/// Colour by rent burden vs estate: red when rent % is > 1 pp above estate, green when > 1 pp below.
	measure 'CF - Rent vs Estate Color' =
			VAR x = [Rent % vs Estate (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 1, "#D64550", IF(x < -1, "#2E8B57", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 66194ee1-64a3-48c1-ab1b-2bc128eb298e

	/// Colour by derived profitability status (5 levels).
	measure 'CF - Derived Status Color' = SWITCH([Derived Profitability Status], "Highly-Profitable", "#1B7F4D", "Profitable", "#5BA97B", "Break-Even", "#E0A800", "Loss-Making", "#D64550", "Structural-Loss", "#8B1A1A", "#808080")
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 89cbb660-f985-4658-88e9-1869346dfec2

	/// Colour by review flag: Review red, Watch amber, OK green.
	measure 'CF - Review Flag Color' = SWITCH([Review Flag], "Review", "#D64550", "Watch", "#E0A800", "OK", "#2E8B57", "#808080")
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 73404236-6a60-4b39-98a6-b04975665272

	/// Green when estimated loyalty net value >= 0, red when negative.
	measure 'CF - Loyalty Net Value Color' =
			VAR x = [Loyalty Net Value (Est.)]
			RETURN IF(ISBLANK(x), "#808080", IF(x >= 0, "#2E8B57", "#D64550"))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: d55f6189-8428-4edc-b436-d7cd796ed1cb

	/// Red when redemption cover is below 1.0x (programme costs more than estimated member margin), green otherwise.
	measure 'CF - Redemption Cover Color' =
			VAR x = [Redemption Cover (x)]
			RETURN IF(ISBLANK(x), "#808080", IF(x < 1, "#D64550", "#2E8B57"))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: c9ff2712-4f96-478b-913c-292e63b20195

	/// Colour by redemption cost % vs estate: red when > 0.5 pp above estate, green when > 0.5 pp below.
	measure 'CF - Redemption vs Estate Color' =
			VAR x = [Redemption Cost % vs Estate (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 0.5, "#D64550", IF(x < -0.5, "#2E8B57", "#808080")))
		displayFolder: 11 Conditional Formatting\CF - Font & Data Colour
		lineageTag: 68b53fbb-79b2-46ae-bec5-1174698ae17e

	/// Colour by member revenue % vs estate (green > +1 pp, red < -1 pp).
	measure 'CF - Member Revenue vs Estate Color' =
			VAR x = [Member Revenue % vs Estate (pp)]
			RETURN IF(ISBLANK(x), "#808080", IF(x > 1, "#2E8B57", IF(x < -1, "#D64550", "#808080")))
