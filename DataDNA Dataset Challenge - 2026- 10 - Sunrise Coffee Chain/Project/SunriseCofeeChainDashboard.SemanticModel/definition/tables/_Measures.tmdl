		lineageTag: 6f3f654c-8390-4efd-bb39-73868638e455

	/// Page 1 title.
	measure 'Title - P1 Executive Overview' = "Executive Performance Overview"
		displayFolder: 08 Titles\Page Titles
		lineageTag: ac759b06-f767-48ee-806f-09532961b2d2

	/// Page 2 title.
	measure 'Title - P2 Store & Region Profitability' = "Store & Regional Profitability"
		displayFolder: 08 Titles\Page Titles
		lineageTag: 68ab0d5c-72a2-463b-86be-1bed72c00e17

	/// Page 3 title.
	measure 'Title - P3 Loyalty Programme' = "Loyalty Programme Effectiveness"
		displayFolder: 08 Titles\Page Titles
		lineageTag: b696f1ac-d568-403b-b765-c823393ba47c

	/// Page 4 title.
	measure 'Title - P4 Revenue Mix & Seasonality' = "Revenue Mix & Seasonal Trading"
		displayFolder: 08 Titles\Page Titles
		lineageTag: 6c60966c-5bea-4cf6-a35d-b71447bfd484

	/// Page 5 (drill-through) title includes the store.
	measure 'Title - P5 Store Deep Dive' = "Store Deep Dive | " & [Label - Store]
		displayFolder: 08 Titles\Page Titles
		lineageTag: e26bf0a9-0d65-47d7-8af0-e46f0361ba88

	/// Page 1 subtitle: period, scope, store count, net profit, margin and YoY change.
	measure 'Subtitle - P1 Executive Overview' =
			VAR PYtxt = IF(ISBLANK([Prior Year]), "", " | " & [Txt - Net Profit Change] & " net profit vs " & FORMAT([Prior Year], "0"))
			RETURN [Label - Period] & " | " & [Label - Scope] & " | " & FORMAT([Store Count], "0") & " stores | Net profit " & [Txt - Net Profit] & " (" & FORMAT([Net Profit Margin %], "0.0%") & " margin)" & PYtxt
		displayFolder: 09 Subtitles\Page Subtitles
		lineageTag: 3bc0ea4e-4d8d-435f-992d-8a7de9a5fddb

	/// Page 2 subtitle with review count.
	measure 'Subtitle - P2 Store & Region Profitability' = [Label - Period] & " | " & [Label - Scope] & " | " & FORMAT([Stores to Review], "0") & " of " & FORMAT([Store Count], "0") & " stores flagged for review (period margin below -2%)"
		displayFolder: 09 Subtitles\Page Subtitles
		lineageTag: 21063d8c-e55b-4637-857d-15d037a213ae

	/// Page 3 subtitle with adoption correlation.
	measure 'Subtitle - P3 Loyalty Programme' =
			VAR r = [Corr - Adoption vs Member Revenue %]
			RETURN [Label - Period] & " | " & [Label - Scope] & " | Adoption vs member-revenue correlation r = " & IF(ISBLANK(r), "n/a (select 3+ stores)", FORMAT(r, "0.00"))
		displayFolder: 09 Subtitles\Page Subtitles
		lineageTag: 189ea6f5-f7a9-4dbc-bbc4-3306f353bc4d

	/// Page 4 subtitle with sample-coverage caveat.
	measure 'Subtitle - P4 Revenue Mix & Seasonality' = [Label - Period] & " | " & [Label - Scope] & " | Daily-sample visuals cover about " & FORMAT([Sample Coverage %], "0%") & " of store-days: read shares and averages, not totals"
		displayFolder: 09 Subtitles\Page Subtitles
		lineageTag: c6bb5d6e-e9e0-4c05-9def-495c3d7d2ea9

	/// Page 5 subtitle: region, rank in estate, derived status.
	measure 'Subtitle - P5 Store Deep Dive' =
			IF(HASONEVALUE(dim_store[store_name]),
			    SELECTEDVALUE(dim_store[region]) & " | " & SELECTEDVALUE(dim_store[location_type]) & " | Net profit rank #" & FORMAT(RANKX(ALL(dim_store[store_name]), [Total Net Profit], , DESC, DENSE), "0") & " of " & FORMAT([Estate Store Count], "0") & " | Status: " & [Derived Profitability Status],
			    "Select a store (drill through from Page 2)")
		displayFolder: 09 Subtitles\Page Subtitles
		lineageTag: e0755db2-9eae-443e-a6bd-5dbf1755d96d

	/// Revenue card comparison text vs prior year.
	measure 'Card Sub - Revenue' = ```
			
			VAR G = [Revenue YoY %]
			RETURN 
			    IF(ISBLANK(G), "Select one year to compare with the prior year", IF(G >= 0, "▲ ", "▼ ") & FORMAT(ABS(G), "0.0%") & " vs " & FORMAT([Prior Year], "0"))
			```
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: 39d9cfbd-6147-4789-b086-cc4e69b59dc2

	/// Net profit card comparison text.
	measure 'Card Sub - Net Profit' =
			VAR G = [Net Profit YoY %]
			RETURN IF(ISBLANK(G), "Select one year to compare with the prior year", IF(G >= 0, "▲ ", "▼ ") & FORMAT(ABS(G), "0.0%") & " vs " & FORMAT([Prior Year], "0") & " (" & [Txt - Net Profit Change] & ")")
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: c9ae1f8f-7391-41c6-b6dc-c33f0f1b7aba

	/// Margin card comparison text in pp.
	measure 'Card Sub - Margin' =
			VAR G = [Net Profit Margin YoY (pp)]
			RETURN IF(ISBLANK(G), "Select one year to compare with the prior year", IF(ROUND(G, 1) = 0, "► flat vs ", IF(G >= 0, "▲ " & FORMAT(ABS(G), "0.0") & " pp vs ", "▼ " & FORMAT(ABS(G), "0.0") & " pp vs ")) & FORMAT([Prior Year], "0") & " (" & FORMAT([PY Net Profit Margin %], "0.0%") & ")")
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: ce368df5-eff5-4f3b-b00d-d4c8d48a8278

	/// Loss-share card comparison text (lower is better).
	measure 'Card Sub - Loss Share' =
			VAR G = [Loss-Making Share YoY (pp)]
			RETURN IF(ISBLANK(G), "Select one year to compare with the prior year", IF(ROUND(G, 1) = 0, "► flat vs ", IF(G >= 0, "▲ " & FORMAT(ABS(G), "0.0") & " pp vs ", "▼ " & FORMAT(ABS(G), "0.0") & " pp vs ")) & FORMAT([Prior Year], "0") & " (" & FORMAT([PY Loss-Making Store-Months %], "0.0%") & ") | " & FORMAT([Loss-Making Store-Months], "0") & " loss-making store-months")
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: 87f22cb1-1681-45b8-a1b0-3d31bf839b03

	/// Redemption cost card comparison text (lower is better).
	measure 'Card Sub - Redemption Cost' =
			VAR G = [Redemption Cost % YoY (pp)]
			RETURN IF(ISBLANK(G), "Select one year to compare with the prior year", IF(ROUND(G, 1) = 0, "► flat vs ", IF(G >= 0, "▲ " & FORMAT(ABS(G), "0.0") & " pp vs ", "▼ " & FORMAT(ABS(G), "0.0") & " pp vs ")) & FORMAT([Prior Year], "0") & " | Cost " & [Txt - Redemption Cost])
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: ee6c9b9a-cab8-48f4-b326-ab63f011a8fc

	/// Member revenue share card comparison text.
	measure 'Card Sub - Member Revenue' =
			VAR G = [Member Revenue % YoY (pp)]
			RETURN IF(ISBLANK(G), "Select one year to compare with the prior year", IF(ROUND(G, 1) = 0, "► flat vs ", IF(G >= 0, "▲ " & FORMAT(ABS(G), "0.0") & " pp vs ", "▼ " & FORMAT(ABS(G), "0.0") & " pp vs ")) & FORMAT([Prior Year], "0") & " (" & FORMAT([PY Loyalty Member Revenue %], "0.0%") & ")")
		displayFolder: 09 Subtitles\Card Comparison
		lineageTag: fa224709-6460-4e8d-bc71-c9e913caa348

	/// Food share card comparison text (sample).
	measure 'Card Sub - Food Share' =
			VAR G = [Food Share YoY (pp)]
			RETURN IF(ISBLANK(G), "Select one year to compare with the prior year", IF(ROUND(G, 1) = 0, "► flat vs ", IF(G >= 0, "▲ " & FORMAT(ABS(G), "0.0") & " pp vs ", "▼ " & FORMAT(ABS(G), "0.0") & " pp vs ")) & FORMAT([Prior Year], "0") & " (" & FORMAT([PY Food Share %], "0.0%") & ")")
		displayFolder: 09 Subtitles\Card Comparison
