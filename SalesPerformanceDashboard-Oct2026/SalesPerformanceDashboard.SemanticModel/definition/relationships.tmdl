relationship FactSales_OrderDate_DimDate
	fromColumn: FactSales.OrderDate
	toColumn: DimDate.Date

relationship FactSales_StockDate_DimDate
	isActive: false
	fromColumn: FactSales.StockDate
	toColumn: DimDate.Date

relationship FactSales_ProductKey_DimProduct
	fromColumn: FactSales.ProductKey
	toColumn: DimProduct.ProductKey

relationship FactSales_CustomerKey_DimCustomer
	fromColumn: FactSales.CustomerKey
	toColumn: DimCustomer.CustomerKey

relationship FactSales_TerritoryKey_DimTerritory
	fromColumn: FactSales.TerritoryKey
	toColumn: DimTerritory.TerritoryKey

relationship FactReturns_ReturnDate_DimDate
	fromColumn: FactReturns.ReturnDate
	toColumn: DimDate.Date

relationship FactReturns_ProductKey_DimProduct
	fromColumn: FactReturns.ProductKey
	toColumn: DimProduct.ProductKey

relationship FactReturns_TerritoryKey_DimTerritory
	fromColumn: FactReturns.TerritoryKey
	toColumn: DimTerritory.TerritoryKey

