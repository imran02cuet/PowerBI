		lineageTag: b95b0c76-598c-4a13-adb4-77490b4aedc8
		summarizeBy: none
		sourceColumn: ProductDescription

	/// Product colour as given in the source (includes 'Multi', 'Silver/Black' and 'NA' for products without a colour). 'Unknown' for the Unknown member.
	column ProductColor
		dataType: string
		lineageTag: 57f06835-8bc1-48b3-a6a1-54fef5505f5e
		summarizeBy: none
		sourceColumn: ProductColor

	/// Product size as given in the source. Stored as text because values mix numeric and lettered sizes; may hold a placeholder where size does not apply.
	column ProductSize
		dataType: string
		lineageTag: 366ff61f-abfa-443a-8d6d-c88fc8a363a5
		summarizeBy: none
		sourceColumn: ProductSize

	/// Product style code from the source: M, W, U or 0 where not applicable. 'Unknown' for the Unknown member.
	column ProductStyle
		dataType: string
		lineageTag: cce44f22-38b7-4730-b3de-1cabe6926d60
		summarizeBy: none
		sourceColumn: ProductStyle

	/// Unit cost of the product (decimal). Not additive; use it in measures (e.g. SUMX over FactSales) rather than summing the column. Blank for the Unknown member.
	column ProductCost
		dataType: decimal
		formatString: #,0.00
		lineageTag: 358cafac-3264-4714-9c89-b9177aa7b92d
		summarizeBy: none
		sourceColumn: ProductCost

	/// Unit list price of the product (decimal). Not additive; use it in measures (e.g. SUMX over FactSales) rather than summing the column. Blank for the Unknown member.
	column ProductPrice
		dataType: decimal
		formatString: #,0.00
		lineageTag: 91d903b2-899c-42b0-8a4c-24a1a0ab1e50
		summarizeBy: none
		sourceColumn: ProductPrice

	/// Product subcategory (middle level of the hierarchy). Flattened from the Product Subcategories lookup. 'Unknown' for the Unknown member.
	column SubcategoryName
		dataType: string
		lineageTag: 9d550779-2060-499c-b11d-e7b769f74abc
