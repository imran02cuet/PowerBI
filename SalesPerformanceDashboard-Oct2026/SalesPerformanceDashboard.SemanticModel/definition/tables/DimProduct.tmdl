/// DIMENSION (product). One row per product: 293 products plus an 'Unknown' member (ProductKey = -1) used for return records whose product is missing from the lookup (294 rows). Flattened from the Product, Product Subcategory and Product Category lookups into a single hierarchy: Category > Subcategory > Product. Filters FactSales and FactReturns via ProductKey.
table DimProduct
	lineageTag: 02511e34-fa9a-4cf2-b988-0d1883ac8b5e

	/// Primary key of the product. Hidden; -1 is the 'Unknown' member for products missing from the lookup.
	column ProductKey
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: ad4e84ce-006f-45b5-b97d-5b88fe53812f
		summarizeBy: none
		sourceColumn: ProductKey

	/// Stock keeping unit code of the product.
	column ProductSKU
		dataType: string
		lineageTag: 326de040-b445-4fd7-b8fc-4e9af4aff98f
		summarizeBy: none
		sourceColumn: ProductSKU

