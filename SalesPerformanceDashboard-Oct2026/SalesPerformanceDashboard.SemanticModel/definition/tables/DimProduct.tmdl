	column ProductName
		dataType: string
		lineageTag: 4b96f273-08ef-4c1d-82dd-1c6525103c70
		summarizeBy: none
		sourceColumn: ProductName

	/// Product model name; several products (e.g. size or colour variants) can share one model.
	column ModelName
		dataType: string
		lineageTag: 25a578ee-45b1-415a-8c4a-80c8ca8e1334
		summarizeBy: none
