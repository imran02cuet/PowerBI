		sourceColumn: SubcategoryName

	/// Product category (top level of the hierarchy). Flattened from the Product Categories lookup. 'Unknown' for the Unknown member.
	column CategoryName
		dataType: string
		lineageTag: a6c2526d-596d-478e-a80d-7b3aacf5bcb1
		summarizeBy: none
		sourceColumn: CategoryName

	partition DimProduct = m
		mode: import
		source =
				let
				    Prod = Table.PromoteHeaders(Csv.Document(Web.Contents("https://raw.githubusercontent.com/chiranjeevikudupudi/Power-BI-Projects/refs/heads/main/007%20Sales%20Dashboard/001_Datasets/006%20Product%20Lookup.csv"), [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.None]), [PromoteAllScalars=true]),
				    ProdTyped = Table.TransformColumnTypes(Prod, {{"ProductKey", Int64.Type}, {"ProductSubcategoryKey", Int64.Type}, {"ProductSKU", type text}, {"ProductName", type text}, {"ModelName", type text}, {"ProductDescription", type text}, {"ProductColor", type text}, {"ProductSize", type text}, {"ProductStyle", type text}, {"ProductCost", Currency.Type}, {"ProductPrice", Currency.Type}}, "en-US"),
				    Sub = Table.PromoteHeaders(Csv.Document(Web.Contents("https://raw.githubusercontent.com/chiranjeevikudupudi/Power-BI-Projects/refs/heads/main/007%20Sales%20Dashboard/001_Datasets/008%20Product%20Subcategories%20Lookup.csv"), [Delimiter=",", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.None]), [PromoteAllScalars=true]),
				    SubTyped = Table.TransformColumnTypes(Sub, {{"ProductSubcategoryKey", Int64.Type}, {"SubcategoryName", type text}, {"ProductCategoryKey", Int64.Type}}, "en-US"),
				    Cat = Table.PromoteHeaders(Csv.Document(Web.Contents("https://raw.githubusercontent.com/chiranjeevikudupudi/Power-BI-Projects/refs/heads/main/007%20Sales%20Dashboard/001_Datasets/007%20Product%20Categories%20Lookup.csv"), [Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.None]), [PromoteAllScalars=true]),
				    CatTyped = Table.TransformColumnTypes(Cat, {{"ProductCategoryKey", Int64.Type}, {"CategoryName", type text}}, "en-US"),
				    SubWithCat = Table.NestedJoin(SubTyped, {"ProductCategoryKey"}, CatTyped, {"ProductCategoryKey"}, "Cat", JoinKind.LeftOuter),
				    SubFlat = Table.ExpandTableColumn(SubWithCat, "Cat", {"CategoryName"}, {"CategoryName"}),
				    SubSlim = Table.SelectColumns(SubFlat, {"ProductSubcategoryKey", "SubcategoryName", "CategoryName"}),
				    Joined = Table.NestedJoin(ProdTyped, {"ProductSubcategoryKey"}, SubSlim, {"ProductSubcategoryKey"}, "Sub", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "Sub", {"SubcategoryName", "CategoryName"}, {"SubcategoryName", "CategoryName"}),
				    Filled = Table.ReplaceValue(Expanded, null, "Unassigned", Replacer.ReplaceValue, {"SubcategoryName", "CategoryName"}),
				    Final = Table.SelectColumns(Filled, {"ProductKey", "ProductSKU", "ProductName", "ModelName", "ProductDescription", "ProductColor", "ProductSize", "ProductStyle", "ProductCost", "ProductPrice", "SubcategoryName", "CategoryName"}),
				    Valid = Table.SelectRows(Final, each [ProductKey] <> null),
				    UnknownRow = #table(type table [ProductKey = Int64.Type, ProductSKU = text, ProductName = text, ModelName = text, ProductDescription = text, ProductColor = text, ProductSize = text, ProductStyle = text, ProductCost = Currency.Type, ProductPrice = Currency.Type, SubcategoryName = text, CategoryName = text], {{-1, "Unknown", "Unknown", "Unknown", "Unknown", "Unknown", "Unknown", "Unknown", null, null, "Unknown", "Unknown"}}),
				    Result = Table.Sort(Table.Combine({Valid, UnknownRow}), {{"ProductKey", Order.Ascending}})
				in
				    Result

